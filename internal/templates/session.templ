package templates

// Session renders the #session region. It holds the join form and nothing
// else: being signed in is state, and state lives in the top bar now, so a
// recognised player gets an empty region rather than a card telling them
// something they can already see.
templ Session(v SessionView) {
	<section id="session" class={ templ.KV("session", !v.SignedIn()) }>
		if !v.SignedIn() {
			// What this card is, before the fields. Somebody who has never
			// been here does not know how little it asks — the feedback after
			// the first week was that "erst einen Nutzer anlegen" felt like
			// the beginning of a registration.
			<h2>Zum ersten Mal hier?</h2>
			<p class="muted">
				Dein Name und eine PIN, keine E-Mail. Nimm den Namen, unter dem
				dich die anderen in der Liste suchen.
			</p>
			<form hx-post="/players" hx-target="#session" hx-swap="outerHTML">
				<div class="row">
					<label for="display-name">Dein Name</label>
					<input
						id="display-name"
						name="display_name"
						value={ v.Name }
						maxlength="40"
						autocomplete="nickname"
						autocapitalize="words"
						required
					/>
				</div>
				// The PIN in the same form, before the player exists
				// (docs/adr/0018). Asked for afterwards it was an offer under a
				// code, and an offer somebody can scroll past is how most
				// players ended up with no way back but a code they had not
				// saved.
				//
				// What was typed is never put back after a refusal (see
				// rejectJoin), so a rejected name costs retyping the PIN.
				<div class="pin-field">
					<label for="join-pin">Deine PIN</label>
					<p class="muted">
						@pinRule()
						Damit meldest du dich auf jedem anderen Gerät an.
					</p>
					<div class="secret-field">
						@pinInput("join-pin")
						@revealButton("join-pin")
					</div>
				</div>
				<button type="submit">Mitspielen</button>
				if v.Error != "" {
					<p class="fail" role="alert">{ v.Error }</p>
				}
			</form>
			// The way on for somebody the picker has nothing to offer. This
			// card is now the second door rather than the first: it shows
			// on an empty roster, and behind the link at the top of the
			// sign-in card the rest of the time.
			//
			// A link rather than a button: a reader who ended up here already
			// knows which of the two they are, because they got here by saying
			// so.
			<p class="session-alt">
				Schon dabei, aber dieses Gerät kennt dich nicht?
				<button
					type="button"
					class="linklike"
					hx-get="/fragments/signin"
					hx-target="#session"
					hx-swap="outerHTML"
				>
					Anmelden
				</button>
			</p>
		}
	</section>
}

// Joined is the one-time display of the recovery code, and the only place
// that code is ever readable — the server keeps a hash of it and nothing else.
//
// docs/adr/0006 is explicit about the shape: the display must be unmistakable
// and must not look like a confirmation message somebody reads past. The
// house style for a card heading is a muted uppercase label, which is exactly
// what "read past" looks like, so this one card breaks the pattern on
// purpose — see the .recovery block in app.css.
//
// The PIN was chosen a step earlier, in the join form, so this card has one
// thing on it rather than two (docs/adr/0018). The order is deliberate: the
// code, what it is for and where to put it, the file for whoever has no
// password manager at hand, and last the reassurance about this device,
// because it is true whether or not anybody reads it.
//
// No copy button. navigator.clipboard is undefined outside a secure context,
// and at the table this is served over http:// on an IP address
// (docs/adr/0007) — the button would be dead in exactly the place it is
// needed. Selectable text instead, which every password manager can take.
templ Joined(v SessionView) {
	<section id="session" class="session recovery">
		<h2>Heb diesen Code auf</h2>
		<p class="recovery-code"><code>{ v.RecoveryCode }</code></p>
		<p class="recovery-lead">
			Er bringt dich zurück, wenn du deine PIN vergessen hast. Speicher
			ihn da, wo deine Passwörter liegen, oder als Datei — angezeigt wird
			er <strong>nur dieses eine Mal</strong>.
		</p>
		@recoveryDownload(v.DisplayName, v.RecoveryCode)
		<p class="muted">
			Dieses Gerät erkennt dich wieder, auch nach einem Neustart. Auf
			einem neuen meldest du dich mit deinem Namen und deiner PIN an.
		</p>
	</section>
}
