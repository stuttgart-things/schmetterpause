package templates

// Session renders the #session region. It holds the join form and nothing
// else: being signed in is state, and state lives in the top bar now, so a
// recognised player gets an empty region rather than a card telling them
// something they can already see.
templ Session(v SessionView) {
	<section id="session" class={ templ.KV("session", !v.SignedIn()) }>
		if !v.SignedIn() {
			<form hx-post="/players" hx-target="#session" hx-swap="outerHTML">
				<label for="display-name">Dein Name</label>
				<input
					id="display-name"
					name="display_name"
					value={ v.Name }
					maxlength="40"
					autocomplete="nickname"
					autocapitalize="words"
					required
				/>
				<button type="submit">Mitspielen</button>
				if v.Error != "" {
					<p class="fail" role="alert">{ v.Error }</p>
				}
			</form>
		}
	</section>
}

// Joined confirms a successful join, once. It is onboarding rather than
// status: it answers a question somebody has exactly at this moment and never
// again, so it is not on the page afterwards.
//
// It no longer names the player. The same response now puts "Hallo, <name>"
// in the heading and the name in the top bar, and a third copy of it in a
// card of its own said nothing the other two did not.
templ Joined(v SessionView) {
	<section id="session" class="session">
		<p class="muted">
			Dieses Gerät erkennt dich wieder — auch nach einem Neustart.
		</p>
	</section>
}
