package templates

// Session renders the #session region: either the join form, or a note
// naming the recognised player. Both carry the same id so the form can
// replace itself with the outcome.
templ Session(v SessionView) {
	<section id="session" class="session">
		if v.SignedIn() {
			<p>
				Angemeldet als <strong>{ v.DisplayName }</strong>.
			</p>
			<p class="muted">
				Dieses Gerät erkennt dich wieder — auch nach einem Neustart.
			</p>
		} else {
			<form hx-post="/players" hx-target="#session" hx-swap="outerHTML">
				<label for="display-name">Dein Name</label>
				<input
					id="display-name"
					name="display_name"
					value={ v.Name }
					maxlength="40"
					autocomplete="nickname"
					autocapitalize="words"
					required
				/>
				<button type="submit">Mitspielen</button>
				if v.Error != "" {
					<p class="fail" role="alert">{ v.Error }</p>
				}
			</form>
		}
	</section>
}
