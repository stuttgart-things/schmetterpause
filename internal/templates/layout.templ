package templates

templ Layout(title string, header HeaderView) {
	<!DOCTYPE html>
	<html lang="de">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } &middot; Schmetterpause</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="/static/js/htmx.min.js" defer></script>
		</head>
		<body>
			<header class="topbar">
				<a class="brand" href="/">Schmetter<span class="brand-mark">pause</span></a>
				<span class="tagline">Büro-Tischtennis</span>
				// Rendered server-side so the name is there on the first
				// paint, and refreshed on a slow timer so the badge turns up
				// when somebody else enters a result against you.
				<span
					id="whoami"
					class="whoami"
					hx-get="/fragments/whoami"
					hx-trigger="every 60s"
					hx-target="this"
					hx-swap="innerHTML"
				>
					@Whoami(header)
				</span>
			</header>
			<main>
				{ children... }
			</main>
			<footer class="footer">
				<a href="/qr">QR-Aushang</a>
				<a href="/healthz">healthz</a>
				<a href="/readyz">readyz</a>
			</footer>
		</body>
	</html>
}

// Whoami is the contents of the top-right corner: who this is, and how much
// is waiting for them. Nothing at all before anybody is recognised — the join
// form on the start page is the thing to look at then.
templ Whoami(v HeaderView) {
	if v.SignedIn() {
		<a class="whoami-name" href={ templ.SafeURL(v.ProfileURL) }>{ v.DisplayName }</a>
		if v.Pending > 0 {
			<a
				class="whoami-badge"
				href="#pending"
				title="Ergebnisse warten auf deine Bestätigung"
				aria-label={ pendingLabel(v.Pending) }
			>
				{ pendingCount(v.Pending) }
			</a>
		}
	}
}

// WhoamiOOB refreshes the corner from a response that did something else.
// innerHTML rather than a whole-element swap, so the polling attributes on
// the container survive it.
templ WhoamiOOB(v HeaderView) {
	<span id="whoami" hx-swap-oob="innerHTML">
		@Whoami(v)
	</span>
}
