package templates

import "strconv"

// Kiosk is the page one machine at the table works from: everybody's results
// entered by whoever is holding the pen.
//
// A page of its own rather than a mode on the start page, because the two
// answer different questions. The start page asks "what did *you* play"; this
// one asks "what just happened at the table", and the ranking beside it is
// what people crane their necks at between matches.
templ Kiosk(v KioskView) {
	@Layout("Kiosk", HeaderView{}) {
		<div class="page-head">
			<div class="page-greeting">
				<h1>Kiosk</h1>
				<p class="muted">
					Ergebnisse zählen sofort — hier trägt ein, wer zugesehen hat.
				</p>
			</div>
			// The kiosk's own colour: it belongs to the table, not to a player.
			@PageMascot(PaddleKiosk)
		</div>
		if v.Operator != "" {
			// Who the results are being credited to, and the way to hand the
			// laptop on. Visible rather than buried, because the machine
			// keeps the name for twelve hours and the person holding it
			// changes rather more often than that (issue #90).
			<p class="muted kiosk-operator">
				Es trägt ein: <strong>{ v.Operator }</strong>
				<a href="/kiosk?operator=1">Übernehmen</a>
			</p>
		}
		if v.Note != "" {
			<div class="kiosk-note" role="status">
				<p>{ v.Note }</p>
				if v.UndoID != "" {
					// A kiosk result counts at once, so there is nothing to
					// dispute and nothing to correct. This is the only way
					// back, and it is only here.
					<form method="post" action={ templ.SafeURL("/kiosk/matches/" + v.UndoID + "/undo") }>
						<button class="secondary" type="submit">Zurücknehmen</button>
					</form>
				}
			</div>
		}
		if v.Error != "" {
			<p class="fail" role="alert">{ v.Error }</p>
		}
		if v.IssuedCode != "" {
			// The one place a credential is shown to somebody it does not
			// belong to. It says whose it is in the heading, because a laptop
			// at a table has more than one person looking at it and a bare
			// code on the screen tells nobody who should write it down.
			<section class="session recovery">
				<h2>{ "Neuer Code für " + v.IssuedFor }</h2>
				<p class="recovery-code"><code>{ v.IssuedCode }</code></p>
				<p class="recovery-lead">
					Vorlesen oder abschreiben lassen, jetzt. Er steht
					<strong>nur hier und nur einmal</strong>, und der alte
					Code von { v.IssuedFor } gilt ab sofort nicht mehr.
				</p>
				<p class="muted">
					Eine PIN kann der Kiosk nicht setzen. Die vergibt
					{ v.IssuedFor } selbst, sobald das eigene Handy wieder
					angemeldet ist.
				</p>
			</section>
		}
		if len(v.Tournaments) > 0 {
			// Above result entry, because during a tournament the form below
			// is the wrong one: a casual result does not land in the table.
			//
			// This list is the only way from the unlocked machine to the
			// entry view for a tournament. The kiosk grant is scoped to
			// /kiosk, so the page at /tournaments/<id> cannot offer the link
			// — it has no way of knowing it is the table.
			<section class="match">
				<h2>Offene Turniere</h2>
				<ul class="tournament-list">
					for _, t := range v.Tournaments {
						<li>
							<a href={ templ.SafeURL("/kiosk/tournaments/" + t.ID) }>{ t.Name }</a>
							<span class="muted">
								{ strconv.Itoa(t.Players) } Spieler,
								{ strconv.Itoa(t.Matches) } Spiele &middot; { t.Mode }
							</span>
						</li>
					}
				</ul>
			</section>
		}
		<section class="match">
			<h2>Ergebnis eintragen</h2>
			if len(v.Players) < 2 {
				<p class="muted">Erst zwei Spieler anlegen.</p>
			} else {
				<form method="post" action="/kiosk/matches">
					<div class="row">
						<label for="kiosk-home">Spieler</label>
						@playerPicker("kiosk-home", "home_id", v.Players, nil)
					</div>
					<div class="row">
						<label for="kiosk-away">Gegner</label>
						@playerPicker("kiosk-away", "away_id", v.Players, nil)
					</div>
					@modeRow("kiosk", v.BestOf, v.PointsToWin)
					@setRows("kiosk", v.Sets, v.BestOf, v.PointsToWin, SideHome, SideAway)
					<button type="submit">Eintragen und werten</button>
				</form>
			}
		</section>
		<section class="match">
			<h2>Spieler anlegen</h2>
			<form method="post" action="/kiosk/players">
				<label for="kiosk-name">Name</label>
				<input
					id="kiosk-name"
					name="display_name"
					maxlength="40"
					autocapitalize="words"
					autocomplete="off"
					required
				/>
				<button type="submit">Anlegen</button>
			</form>
		</section>
		if len(v.Players) > 0 {
			// The last resort, and the reason it is here rather than in the
			// ordinary interface: this is for somebody who has lost the code
			// *and* every device that knew them, so nothing they hold can
			// prove who they are. What stands in for the proof is the room —
			// somebody is beside them and the people here know each other
			// (docs/adr/0006).
			<section class="match">
				<h2>Zugang wiederherstellen</h2>
				<p class="muted">
					Für jemanden, der neben dir steht und weder Code noch ein
					angemeldetes Gerät mehr hat.
				</p>
				<form method="post" action="/kiosk/credentials">
					<label for="kiosk-recover">Spieler</label>
					<select id="kiosk-recover" name="player_id" required>
						<option value="">bitte wählen</option>
						for _, p := range v.Players {
							<option value={ p.ID }>{ p.DisplayName }</option>
						}
					</select>
					<button class="secondary" type="submit">Neuen Code ausgeben</button>
				</form>
			</section>
		}
		@Standings(v.Standings)
	}
}

// The pickers redraw the set rows, because the rows are headed with the two
// names and a heading that lags behind the picker is worse than none. The
// same response carries the other picker back, without whoever this one now
// holds — see PlayerPickerOOB.
templ playerPicker(id, name string, players []OpponentOption, extra templ.Attributes) {
	<select
		id={ id }
		name={ name }
		required
		hx-get="/fragments/sets"
		hx-target="#sets-kiosk"
		hx-swap="outerHTML"
		hx-include="closest form"
		hx-sync="closest form:replace"
		{ extra... }
	>
		<option value="">bitte wählen</option>
		for _, p := range players {
			<option value={ p.ID } selected?={ p.Selected }>{ p.DisplayName }</option>
		}
	</select>
}

// PlayerPickerOOB replaces the picker that did not change, so it can no
// longer offer the player the other one now holds. Nobody plays themselves,
// and finding that out after typing three sets is finding it out too late.
templ PlayerPickerOOB(p KioskPicker) {
	@playerPicker(p.ID, p.Name, p.Players, templ.Attributes{"hx-swap-oob": "true"})
}

// KioskUnlock is the door to the machine at the table.
//
// A form rather than a token in the address, because a URL carrying the code
// stays in the history and the autocomplete of a laptop that gets borrowed —
// and it travels wherever somebody pastes the link. The secret is the same
// either way; what changes is where it ends up.
//
// The page says nothing about the tournament behind it. Somebody who has not
// been told the code has no business learning what is being played from a
// screen they cannot open.
templ KioskUnlock(v KioskUnlockView) {
	@Layout("Kiosk", HeaderView{}) {
		<div class="page-head">
			<div class="page-greeting">
				<h1>Kiosk</h1>
				<p class="muted">
					Das Gerät an der Platte, an dem alle Ergebnisse eingetragen
					werden. Der Zugangscode steht bei dem, der den Abend
					aufgesetzt hat.
				</p>
			</div>
			@PageMascot(PaddleKiosk)
		</div>
		<section class="session">
			<h2>Zugangscode</h2>
			if v.Error != "" {
				<p class="error" role="alert">{ v.Error }</p>
			}
			<form method="post" action="/kiosk/unlock">
				<div class="secret-row">
					<label class="sr-only" for="kiosk-code">Zugangscode</label>
					<input
						id="kiosk-code"
						name="code"
						type="password"
						autocapitalize="none"
						autocorrect="off"
						autocomplete="off"
						spellcheck="false"
						required
					/>
					// Verdeckt, weil die Kiste danach herumsteht — und mit
					// Knopf, weil ein blind getippter Code sonst wie ein
					// falscher aussieht. Ohne JavaScript bleibt das Feld
					// benutzbar, der Knopf tut dann nichts.
					<button
						type="button"
						class="secret-reveal"
						data-reveal="kiosk-code"
						aria-controls="kiosk-code"
						aria-pressed="false"
					>
						Zeigen
					</button>
				</div>
				<button type="submit">Freischalten</button>
			</form>
			<p class="field-alt">
				Einmal pro Gerät. Danach bleibt es rund zwölf Stunden
				freigeschaltet, und ein Admin kann es jederzeit zurücknehmen.
			</p>
		</section>
	}
}

// KioskOperator asks who is holding the pen, and is the only thing an
// unlocked machine shows until it has an answer (issue #90).
//
// A kiosk result settles the moment it is entered, so the opponent never gets
// to agree with it. That was defensible while the trust came from the room —
// a laptop at a table, everybody watching. On a server the room stops being
// the boundary, and the smallest honest replacement is a name: the result is
// credited to whoever typed it, and the server refuses a match that person
// plays in.
//
// Deliberately not a login. The laptop is shared by everybody at the table
// and must not end up signed in as one of them.
templ KioskOperator(v KioskOperatorView) {
	@Layout("Kiosk", HeaderView{}) {
		<div class="page-head">
			<div class="page-greeting">
				<h1>Wer trägt ein?</h1>
				<p class="muted">
					Ergebnisse von diesem Gerät zählen sofort, ohne dass jemand
					sie bestätigt. Deshalb steht dabei, wer sie eingetippt hat.
				</p>
			</div>
			@PageMascot(PaddleKiosk)
		</div>
		<section class="session">
			if v.Current != "" {
				<p class="muted">
					Bisher trägt <strong>{ v.Current }</strong> ein. Wer jetzt
					übernimmt, wählt sich hier aus.
				</p>
			}
			if v.Error != "" {
				<p class="error" role="alert">{ v.Error }</p>
			}
			<form method="post" action="/kiosk/operator">
				// A plain select and not playerPicker: that one carries the
				// hx-get that reloads the set rows, which belongs to result
				// entry and has nothing to do here.
				<label class="sr-only" for="kiosk-operator">Wer trägt ein?</label>
				<select id="kiosk-operator" name="operator_id" required>
					<option value="">Bitte wählen</option>
					for _, p := range v.Players {
						<option value={ p.ID }>{ p.DisplayName }</option>
					}
				</select>
				<button type="submit">Weiter</button>
			</form>
			<p class="muted">
				Das eigene Spiel trägt niemand hier ein — das geht auf der
				Startseite, damit der Gegner es bestätigen kann.
			</p>
		</section>
	}
}
