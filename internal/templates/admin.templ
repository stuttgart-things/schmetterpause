package templates

import "strconv"

// Admin is the page that answers "who may act for other people".
//
// The Definition of Done in issue #88 asks for exactly that, and until
// docs/adr/0008 there was no answer: the only elevated thing was a cookie
// whose value is identical in every browser that ever opened the kiosk token
// URL, which names a machine and never a person.
//
// The boundary is written out here rather than left in the ADR. Somebody who
// wonders whether the laptop at the table can delete a result is standing in
// front of the application, not in front of the repository.
templ Admin(v AdminView) {
	@Layout("Rechte", v.Header) {
		<p class="back"><a href="/">&larr; Rangliste</a></p>
		<div class="page-head">
			<div class="page-greeting">
				<h1>Wer für andere handeln darf</h1>
				<p class="muted">
					Eine Stufe, keine Rollen. Wer sie hat, handelt in seiner
					eigenen Sitzung, und jede solche Handlung steht im Log.
				</p>
			</div>
		</div>
		if v.Note != "" {
			<p class="note" role="status">{ v.Note }</p>
		}
		if v.Error != "" {
			<p class="error" role="alert">{ v.Error }</p>
		}
		<section class="session">
			<h2>Admins</h2>
			if len(v.People) == 0 {
				<p class="muted">
					Niemand. Der erste kommt über <code>SP_BOOTSTRAP_ADMIN</code>
					beim Start — der Anzeigename genügt.
				</p>
			} else {
				<ul class="admin-list">
					for _, p := range v.People {
						<li>
							<a href={ templ.SafeURL("/players/" + p.ID) }>{ p.DisplayName }</a>
							if p.IsSelf {
								<span class="muted">(du)</span>
							}
						</li>
					}
				</ul>
			}
		</section>
		<section class="session">
			<h2>Freigeschaltete Kiosk-Geräte</h2>
			if len(v.Kiosks) == 0 {
				<p class="muted">
					Gerade keins. Ein Gerät wird eins, indem es einmal
					<code>/kiosk?token=…</code> öffnet, und bleibt es zwölf
					Stunden.
				</p>
			} else {
				<div class="table-scroll" tabindex="0" role="region" aria-label="Freigeschaltete Kiosk-Geräte">
					<table class="matches">
						<thead>
							<tr>
								<th scope="col">Gerät</th>
								<th scope="col">Trägt ein</th>
								<th scope="col">Zuletzt gesehen</th>
								<th scope="col">Läuft ab</th>
								<th scope="col"></th>
							</tr>
						</thead>
						<tbody>
							for _, k := range v.Kiosks {
								<tr>
									<td class="kiosk-agent">{ k.Label() }</td>
									// Who results from this machine are
									// credited to (issue #90). A machine that
									// has not answered cannot write anything,
									// so the dash is a state and not a gap.
									<td>
										if k.Operator != "" {
											{ k.Operator }
										} else {
											<span class="muted">noch niemand</span>
										}
									</td>
									<td class="when">{ k.LastSeen }</td>
									<td class="when">{ k.Expires }</td>
									<td>
										<form method="post" action={ templ.SafeURL("/admin/kiosk/" + k.ID + "/revoke") }>
											<button class="secondary" type="submit">Zurücknehmen</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				// The one that logs out the table as well, which is the point
				// of it: it is for the moment somebody read the token over a
				// shoulder, and then everything has to go.
				<form method="post" action="/admin/kiosk/revoke-all">
					<button class="secondary" type="submit">Alle zurücknehmen</button>
				</form>
				<p class="muted">
					Ein zurückgenommenes Gerät ist sofort keins mehr. Um wieder
					eines zu werden, muss es das Token erneut eingeben — das
					gilt auch für den Laptop am Tisch.
				</p>
			}
		</section>
		<section class="session">
			<h2>Gewertete Ergebnisse</h2>
			<p class="muted">
				Ein gewertetes Ergebnis lässt sich nicht ändern — es gibt
				nichts mehr zu korrigieren, nachdem es zwei Wertungen bewegt
				hat. Ein falsches wird entfernt, beide Wertungen stehen dann
				wieder wie vorher, und das richtige wird normal eingetragen.
			</p>
			if len(v.Matches) == 0 {
				<p class="muted">Noch nichts gewertet.</p>
			} else {
				<div class="table-scroll" tabindex="0" role="region" aria-label="Gewertete Ergebnisse">
					<table class="matches">
						<thead>
							<tr>
								<th scope="col">Wann</th>
								<th scope="col">Sieger</th>
								<th scope="col">Gegner</th>
								<th scope="col" class="num">Sätze</th>
								<th scope="col">Verlauf</th>
								<th scope="col"></th>
							</tr>
						</thead>
						<tbody>
							for _, m := range v.Matches {
								<tr>
									<td class="when">{ m.PlayedAt }</td>
									<td>{ m.WinnerName }</td>
									<td>{ m.LoserName }</td>
									<td class="num">
										{ strconv.Itoa(m.WinnerSets) }:{ strconv.Itoa(m.LoserSets) }
									</td>
									<td class="sets">
										for i, set := range m.Sets {
											if i > 0 {
												{ ", " }
											}
											{ strconv.Itoa(set.Own) }:{ strconv.Itoa(set.Opponent) }
										}
									</td>
									<td>
										<form method="post" action={ templ.SafeURL("/admin/matches/" + m.ID + "/remove") }>
											<button class="secondary" type="submit">Entfernen</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				<p class="muted">
					Entfernen geht nur, solange für beide Beteiligten seither
					nichts Neues gewertet wurde. Sonst würde die spätere
					Wertung stillschweigend mit zurückgenommen — dann erst das
					neuere Ergebnis entfernen. Niemand bestätigt das hier:
					es steht im Log, und es steht in <code>docs/adr/0008</code>,
					warum die Stufe wenigen gehört.
				</p>
			}
		</section>
		<section class="session">
			<h2>Spieler ohne Ergebnis</h2>
			<p class="muted">
				Ein Scherzeintrag oder eine Dublette, angelegt bevor jemand
				gespielt hat. Wer einmal gespielt, ein Ergebnis eingetragen
				oder ein Turnier gestartet hat, bleibt — das entscheidet die
				Datenbank, nicht diese Liste.
			</p>
			if len(v.Removable) == 0 {
				<p class="muted">Niemand — alle hier haben schon gespielt.</p>
			} else {
				<div class="table-scroll" tabindex="0" role="region" aria-label="Spieler ohne Ergebnis">
					<table class="matches">
						<thead>
							<tr>
								<th scope="col">Spieler</th>
								<th scope="col">Dabei seit</th>
								<th scope="col"></th>
							</tr>
						</thead>
						<tbody>
							for _, p := range v.Removable {
								<tr>
									<td class="name">
										<a href={ templ.SafeURL("/players/" + p.ID) }>{ p.DisplayName }</a>
										if p.IsSelf {
											<span class="muted">(du)</span>
										}
									</td>
									<td class="when">{ p.Joined }</td>
									<td>
										// Kein Knopf in der eigenen Zeile: wer sich
										// selbst entfernt, ist danach als jemand
										// angemeldet, den es nicht mehr gibt.
										if !p.IsSelf {
											<form method="post" action={ templ.SafeURL("/admin/players/" + p.ID + "/remove") }>
												<button class="secondary" type="submit">Entfernen</button>
											</form>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				<p class="muted">
					Mit einem entfernten Spieler gehen seine Anmeldung, seine
					PIN und sein Wiederherstellungscode. Ein Kiosk, der ihn als
					Eintragenden genannt hat, bleibt freigeschaltet und weiß
					danach nicht mehr, wer tippt.
				</p>
			}
		</section>
		<section class="session">
			<h2>Die Grenze</h2>
			<div class="table-scroll" tabindex="0" role="region" aria-label="Wer was darf">
				<table class="matches">
					<thead>
						<tr>
							<th scope="col">Handlung</th>
							<th scope="col">Kiosk</th>
							<th scope="col">Admin</th>
						</tr>
					</thead>
					<tbody>
						@rightsRow("Ergebnis für beliebige Spieler eintragen", true, false)
						@rightsRow("Ein Ergebnis binnen zehn Minuten zurücknehmen", true, false)
						@rightsRow("Wiederherstellungscode für jemanden im Raum", true, false)
						@rightsRow("Gewertetes Ergebnis korrigieren oder entfernen", false, true)
						@rightsRow("Zwei Spieler zusammenführen", false, true)
						@rightsRow("Einen Spieler entfernen", false, true)
						@rightsRow("Ein Turnier abrechnen", false, true)
						@rightsRow("Eine PIN für jemand anderen setzen", false, false)
					</tbody>
				</table>
			</div>
			<p class="muted">
				Die letzte Zeile ist Absicht: eine PIN, die jemand anderes
				kennt, ist keine PIN. Die vergibt jeder nur für sich selbst.
				Nachzulesen in <code>docs/adr/0008</code>.
			</p>
		</section>
	}
}

// rightsRow is one line of the boundary table. Ja and nein rather than ticks:
// a tick and an empty cell are told apart by whoever already knows which
// column means what.
templ rightsRow(action string, kiosk, admin bool) {
	<tr>
		<td>{ action }</td>
		<td>
			@yesNo(kiosk)
		</td>
		<td>
			@yesNo(admin)
		</td>
	</tr>
}

templ yesNo(allowed bool) {
	if allowed {
		<span class="state state-pending">ja</span>
	} else {
		<span class="muted">nein</span>
	}
}
