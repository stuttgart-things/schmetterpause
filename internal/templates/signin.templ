package templates

// SignIn is the front door once anybody is on the roster, and the way back
// for a browser that has no cookie any more — which turned out to be the same
// door. Joining happens once per person; being forgotten by a browser happens
// again and again, so this is what most arrivals need and it is what the
// start page opens on (see IndexView.ShowSignIn).
//
// Name first, secret second, one form for both kinds (docs/adr/0007). The
// field takes a PIN or a recovery code without asking which, because
// somebody who has to pick would first have to know the difference — and the
// server can tell from the shape of what was typed.
//
// It renders into #session, the same region the join form uses, so the two
// replace each other in place instead of stacking two ways in.
templ SignIn(v SignInView) {
	<section id="session" class="session">
		<h2>Anmelden</h2>
		// The other door, first thing on the card (docs/adr/0018). Somebody new
		// reading a list of names they are not on cannot tell whether they
		// are looking at the wrong card, and a way out at the bottom of it was
		// found by the people who read that far — which, after two rounds of
		// feedback, is not the people who are new.
		<p class="session-new">
			Neu hier?
			<button
				type="button"
				class="linklike"
				hx-get="/fragments/join"
				hx-target="#session"
				hx-swap="outerHTML"
			>
				Hier eintragen
			</button>
		</p>
		<form class="signin" hx-post="/signin" hx-target="#session" hx-swap="outerHTML">
			<div class="row">
				<label for="signin-player">Wer bist du?</label>
				<select id="signin-player" name="player_id" required>
					<option value="" disabled selected?={ !v.anySelected() }>Namen wählen …</option>
					for _, p := range v.Players {
						<option value={ p.ID } selected?={ p.Selected }>{ p.DisplayName }</option>
					}
				</select>
			</div>
			// Everything under the name waits for the name. The placeholder has
			// an empty value on a required select, so the select is :invalid
			// until somebody is chosen, and app.css hides this block for exactly
			// that long. No request and no script: a refused attempt comes back
			// with the name still selected, and the field is simply there. A
			// browser without :has shows it from the start, which is how the
			// form looked before.
			<div class="signin-secret">
				<label for="signin-secret">PIN oder Wiederherstellungscode</label>
				<div class="secret-field">
					// One field on the ordinary keyboard, which can type both.
					// The number pad from issue #117 cannot type a code, and the
					// switch that made up for it was one more thing to understand
					// before signing in (docs/adr/0018). Digits are one tap away
					// on any phone keyboard; letters are not on a number pad.
					//
					// type=password so a password manager recognises the field
					// and offers what it saved — which is where docs/adr/0006
					// asked people to put the code in the first place.
					<input
						id="signin-secret"
						name="secret"
						type="password"
						autocomplete="current-password"
						autocorrect="off"
						spellcheck="false"
						required
					/>
					@revealButton("signin-secret")
				</div>
				<button type="submit">Anmelden</button>
			</div>
			if v.Error != "" {
				<p class="fail" role="alert">{ v.Error }</p>
			}
		</form>
	</section>
}

// SignedIn confirms that a browser is back in touch with its player.
//
// Short on purpose. The name is in the top bar and in the greeting by the
// time this is read, and the interesting thing about signing in is that
// everything else on the page just came back.
templ SignedIn(v SessionView) {
	<section id="session" class="session">
		<p class="muted">
			Willkommen zurück. Dieses Gerät erkennt dich ab jetzt wieder.
		</p>
	</section>
}
