package templates

import (
	"strconv"

	"github.com/stuttgart-things/schmetterpause/web"
)

// RulesSheet is the second printable sheet: what counts at this table, for
// the wall beside the QR code.
//
// The numbers in the prose are derived from the same helpers the entry form
// reads, not typed out. A sheet taped to a wall outlives the release that
// printed it, and rules on the wall that the app disagrees with are worse
// than no rules on the wall.
//
// No print button, for the reason given on the QR sheet: every browser has a
// menu entry and a shortcut for it, and invariant 7 is not spent on that.
templ RulesSheet(v RulesSheetView) {
	@Layout("Regeln", v.Header) {
		<article class="sheet">
			// Decorative: the heading says what the sheet is, and a screen
			// reader gains nothing from hearing the cat described.
			<span class={ "sheet-mascot", PaddleRules }>
				@templ.Raw(web.Mascot)
			</span>
			<h1>Regeln</h1>
			<p class="sheet-lead">Worauf wir uns an der Platte geeinigt haben.</p>
			// A description list rather than a numbered one: the rules hold
			// all at once, and numbering them would claim an order or a
			// precedence between them that does not exist.
			<dl class="rules">
				<div>
					<dt>Aufschlag diagonal (&raquo;Acker&laquo;)</dt>
					<dd>
						Der Ball springt erst auf der eigenen Hälfte auf und muss
						danach auf der diagonal gegenüberliegenden Hälfte des
						Gegners aufkommen &mdash; wie im Doppel. Kommt er woanders
						auf, geht der Punkt an den Gegner.
					</dd>
				</div>
				<div>
					<dt>Der erste Aufschlag wird ausgespielt</dt>
					<dd>
						Vor dem ersten Satz wirft ein Spieler den Ball ein, und wer
						den Ballwechsel gewinnt, schlägt zuerst auf. In jedem
						weiteren Satz beginnt, wer den vorherigen verloren hat.
						// The exception, on the rule it is an exception to
						// rather than as a seventh rule of its own — and on
						// the sheet, because that is what hangs on the wall
						// where nobody reads a code comment (docs/adr/0013).
						<strong>Im Turnier nicht:</strong> dort steht im
						Spielplan, wer auf welcher Seite beginnt und
						aufschlägt. Bei achtundzwanzig Paarungen wäre
						Einwerfen der halbe Nachmittag.
					</dd>
				</div>
				// Directly after the rule about who serves the next set: both
				// are what changes when a set ends, and somebody reading one
				// is about to want the other.
				<div>
					<dt>Seitenwechsel nach jedem Satz</dt>
					<dd>
						Nach jedem Satz werden die Seiten getauscht. Wer wo
						steht, entscheidet über Licht, Zug und die Tischseite
						mit der Delle &mdash; über einen ganzen Satz gerechnet
						ist das kein Detail.
					</dd>
				</div>
				<div>
					<dt>
						Aufschlagwechsel nach { strconv.Itoa(ServeEvery(v.PointsToWin)) } Punkten
					</dt>
					<dd>
						Wer aufschlägt, schlägt { strconv.Itoa(ServeEvery(v.PointsToWin)) } Punkte
						am Stück auf &mdash; egal, wer sie holt. Danach wechselt der
						Aufschlag.
					</dd>
				</div>
				<div>
					<dt>Zwei Punkte Abstand</dt>
					<dd>
						Ein Satz geht bis { strconv.Itoa(v.PointsToWin) }. Steht es
						{ strconv.Itoa(DeuceFrom(v.PointsToWin)) }:{ strconv.Itoa(DeuceFrom(v.PointsToWin)) },
						geht er weiter, bis jemand zwei Punkte vorn liegt &mdash; und
						der Aufschlag wechselt dann nach jedem Punkt.
					</dd>
				</div>
				<div>
					<dt>Netzroller beim Aufschlag wird wiederholt</dt>
					<dd>
						Berührt der Aufschlag das Netz und kommt trotzdem gültig
						auf, zählt er nicht. Derselbe Spieler schlägt noch einmal
						auf.
					</dd>
				</div>
				// Directly under the let, because the two are the pair
				// somebody actually confuses: the ball that touches the net
				// and lands is repeated, the one that does not land is a
				// point.
				<div>
					<dt>Kein zweiter Aufschlag</dt>
					<dd>
						Anders als beim Tennis gibt es keinen zweiten Versuch.
						Bleibt der Aufschlag im Netz oder geht er darüber, ohne
						auf der Platte aufzukommen, geht der Punkt an den
						Gegner.
					</dd>
				</div>
			</dl>
			<p class="sheet-note muted">
				Ergebnis danach eintragen &mdash; der QR-Aushang daneben führt
				direkt hin.
			</p>
			// The other sheet is the thing to do next — whoever printed this
			// one is standing at the printer for both — so it looks like an
			// action and the way home stays the quiet line under it.
			<p class="sheet-next no-print">
				<a class="button-link" href="/qr">Zum QR-Aushang</a>
			</p>
			<p class="sheet-back no-print"><a href="/">Zurück zur Startseite</a></p>
		</article>
	}
}
