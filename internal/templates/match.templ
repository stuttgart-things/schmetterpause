package templates

import "strconv"

// MatchForm renders result entry. The mode controls come pre-set to
// best-of-five to eleven, so the common case costs no interaction at all —
// the budget in AP7 is three from scanning the code to a submitted result.
templ MatchForm(v MatchFormView) {
	<section id="match" class="match">
		<h2>Ergebnis eintragen</h2>
		if len(v.Opponents) == 0 {
			<p class="muted">
				Sobald jemand anderes mitspielt, kannst du hier ein Ergebnis
				eintragen.
			</p>
		} else {
			<form hx-post="/matches" hx-target="#match" hx-swap="outerHTML">
				<div class="row">
					<label for="opponent">Gegner</label>
					<select
						id="opponent"
						name="opponent_id"
						required
						hx-get="/fragments/sets"
						hx-target="#sets-entry"
						hx-swap="outerHTML"
						hx-include="closest form"
						hx-sync="closest form:replace"
					>
						<option value="">bitte wählen</option>
						for _, o := range v.Opponents {
							<option value={ o.ID } selected?={ o.Selected }>{ o.DisplayName }</option>
						}
					</select>
				</div>
				@modeRow("entry", v.BestOf, v.PointsToWin)
				@setRows("entry", v.Sets, v.BestOf, v.PointsToWin, SideYourself, v.AwayLabel())
				<button type="submit">Eintragen</button>
				if v.Error != "" {
					<p class="fail" role="alert">{ v.Error }</p>
				}
			</form>
		}
	</section>
}

// modeRow is the best-of and points-per-set pair, shared by result entry and
// the correction form.
//
// The ids carry a prefix because both forms can be on the page at once — a
// contested match sits in the list right above the entry form, and two
// elements answering to #best-of would leave the labels pointing at whichever
// one the browser found first.
templ modeRow(prefix string, bestOf, pointsToWin int) {
	<div class="row">
		<label for={ prefix + "-best-of" }>Modus</label>
		// Both selects re-render the set rows: best-of decides how many there
		// are, and the target score decides what the rule underneath them
		// says. hx-include carries what is already typed, so changing the
		// mode does not empty the boxes.
		<select
			id={ prefix + "-best-of" }
			name="best_of"
			hx-get="/fragments/sets"
			hx-target={ "#sets-" + prefix }
			hx-swap="outerHTML"
			hx-include="closest form"
			hx-sync="closest form:replace"
		>
			for _, n := range []int{3, 5, 7} {
				<option value={ strconv.Itoa(n) } selected?={ bestOf == n }>
					Best of { strconv.Itoa(n) }
				</option>
			}
		</select>
		<select
			id={ prefix + "-points-to-win" }
			name="points_to_win"
			aria-label="Punkte pro Satz"
			hx-get="/fragments/sets"
			hx-target={ "#sets-" + prefix }
			hx-swap="outerHTML"
			hx-include="closest form"
			hx-sync="closest form:replace"
		>
			for _, p := range []int{11, 21} {
				<option value={ strconv.Itoa(p) } selected?={ pointsToWin == p }>
					bis { strconv.Itoa(p) }
				</option>
			}
		</select>
	</div>
}

// setRows is the set-by-set score, always from the reader's own side.
//
// It shows as many rows as the mode can have and no more, and it carries the
// prefix in a hidden field so /fragments/sets can render itself back into the
// right form when the mode changes — three of these can be on one page.
//
// The boxes have no maximum on purpose: at eleven, 12:10 and 13:11 are
// ordinary results, so any cap that would reject 15:8 would reject those too.
// The rule is written out instead, and the server has the last word.
templ setRows(prefix string, sets []SetInput, bestOf, pointsToWin int, homeLabel, awayLabel string) {
	<fieldset id={ "sets-" + prefix } class="sets">
		<legend>Sätze</legend>
		<input type="hidden" name="sets_prefix" value={ prefix }/>
		<p id={ "sets-rule-" + prefix } class="muted">
			Bis { strconv.Itoa(pointsToWin) } Punkte. Steht es
			{ strconv.Itoa(DeuceFrom(pointsToWin)) }:{ strconv.Itoa(DeuceFrom(pointsToWin)) },
			geht der Satz weiter, bis jemand zwei Punkte vorn liegt. Nicht
			gespielte Sätze leer lassen.
		</p>
		// Which column is whose. The colon between two boxes says nothing
		// about that, and at the table nobody stops to work it out.
		<div class="set set-head" aria-hidden="true">
			<span class="set-no"></span>
			<span class="set-side">{ homeLabel }</span>
			// A colon that is there but not shown: an empty span is zero
			// wide, and the right-hand heading would sit four pixels off the
			// box it belongs to.
			<span class="colon">:</span>
			<span class="set-side">{ awayLabel }</span>
		</div>
		for i, s := range SetRows(sets, bestOf) {
			<div class="set">
				<span class="set-no">{ strconv.Itoa(i + 1) }.</span>
				@scoreField(prefix, "set_home_"+strconv.Itoa(i+1), s.Home, pointsToWin,
					"Satz "+strconv.Itoa(i+1)+", Punkte "+homeLabel)
				<span class="colon">:</span>
				@scoreField(prefix, "set_away_"+strconv.Itoa(i+1), s.Away, pointsToWin,
					"Satz "+strconv.Itoa(i+1)+", Punkte "+awayLabel)
			</div>
		}
	</fieldset>
}

// scoreField is one score: the box that is submitted, and a slider under it
// that sets the same value.
//
// The box stays the input of record, and the slider carries no name, so it
// submits nothing. That is what keeps an unplayed set empty — a slider always
// has a position, and "leave unplayed sets empty" would stop working if the
// position were the value.
//
// The slider only reaches its own box; the wiring is four lines in app.js,
// because there is no HTML that links two inputs.
templ scoreField(prefix, name, value string, pointsToWin int, label string) {
	<span class="score">
		<input
			type="number"
			id={ prefix + "-" + name }
			name={ name }
			value={ value }
			min="0"
			inputmode="numeric"
			aria-label={ label }
			aria-describedby={ "sets-rule-" + prefix }
		/>
		// Up to ten past the target, which covers a deuce nobody in an office
		// has ever played out. Beyond that the box still takes anything.
		<input
			class="score-slider"
			type="range"
			min="0"
			max={ strconv.Itoa(pointsToWin + 10) }
			value={ sliderStart(value) }
			data-score={ prefix + "-" + name }
			aria-label={ label + ", Schieberegler" }
			tabindex="-1"
		/>
	</span>
}

// SetsFragment is the set rows on their own, for the swap that follows a
// change of mode. Every form on the page has its own, told apart by prefix.
templ SetsFragment(v SetsView) {
	@setRows(v.Prefix, v.Sets, v.BestOf, v.PointsToWin, v.HomeLabel, v.AwayLabel)
	if v.Picker != nil {
		@PlayerPickerOOB(*v.Picker)
	}
}

// MatchRecorded confirms the entry and says what happens next. It is
// deliberately explicit that the result does not count yet: an unconfirmed
// match changes no rating, and hiding that would make the ranking look wrong
// rather than incomplete.
templ MatchRecorded(v MatchRecordedView) {
	<section id="match" class="match">
		<h2>Eingetragen</h2>
		<p>
			if v.Won {
				<strong>Gewonnen</strong>
			} else {
				<strong>Verloren</strong>
			}
			gegen { v.OpponentName } mit
			{ strconv.Itoa(v.OwnSets) }:{ strconv.Itoa(v.OpponentSets) } Sätzen.
		</p>
		<p class="muted">
			{ v.OpponentName } muss das Ergebnis noch bestätigen. Bis dahin
			zählt es nicht für die Wertung.
		</p>
		<button hx-get="/fragments/match" hx-target="#match" hx-swap="outerHTML">
			Noch ein Ergebnis
		</button>
	</section>
}
