package templates

// PINForm is where a player sets or replaces their PIN.
//
// It renders into #pin-offer rather than into the region around it, and that
// is load-bearing at join: the card it sits in is showing the recovery code
// for the only time it will ever be shown, and a form that swapped the card
// out would take the code with it before anybody had saved it (docs/adr/0006).
templ PINForm(v PINFormView) {
	<div id="pin-offer" class="pin-offer">
		if v.Done {
			<p class="ok">
				PIN gesetzt. Damit kommst du auf einem neuen Gerät wieder an
				deinen Spieler.
			</p>
		} else {
			<form hx-post="/credentials/pin" hx-target="#pin-offer" hx-swap="outerHTML">
				<label for="pin">{ v.Heading() }</label>
				<p class="muted">
					Mindestens { MinPIN } Ziffern, und etwas, das du dir merkst.
					Der Wiederherstellungscode gilt weiter — die PIN ersetzt
					ihn nicht.
				</p>
				<div class="secret-field">
					// inputmode and pattern make a phone show the number pad,
					// and the digits-only rule is what keeps this from
					// becoming a field somebody puts their company password
					// in (docs/adr/0007).
					<input
						id="pin"
						name="pin"
						type="password"
						inputmode="numeric"
						pattern="[0-9]*"
						autocomplete="new-password"
						minlength={ MinPIN }
						maxlength={ MaxPIN }
						required
					/>
					<button
						type="button"
						class="secret-reveal"
						data-reveal="pin"
						aria-controls="pin"
						aria-pressed="false"
					>
						Zeigen
					</button>
				</div>
				<button type="submit">{ v.Action() }</button>
				if v.Error != "" {
					<p class="fail" role="alert">{ v.Error }</p>
				}
			</form>
		}
	</div>
}

// RecoveryCard is the recovery code on somebody's own profile: the way to
// replace it, and the one-time display of what replacing it produced.
//
// It exists because of when it is needed. No kiosk runs in an ordinary week,
// so a way to get a fresh code that only existed on tournament evenings would
// be no way at all from Wednesday to Tuesday (docs/adr/0006).
templ RecoveryCard(v RecoveryCardView) {
	<section id="recovery" class="session recovery-card">
		<h2>Wiederherstellungscode</h2>
		if v.Code != "" {
			<p class="recovery-code"><code>{ v.Code }</code></p>
			<p class="recovery-lead">
				Speicher ihn da, wo deine Passwörter liegen. Er wird
				<strong>nur dieses eine Mal</strong> angezeigt, und dein
				alter Code gilt ab jetzt nicht mehr.
			</p>
		} else {
			<p class="muted">
				Der Code von deinem ersten Besuch gilt weiter. Wenn du ihn
				verloren hast oder er irgendwo gelandet ist, wo er nicht
				hingehört, erzeug einen neuen — der alte gilt dann sofort
				nicht mehr.
			</p>
			<button
				class="secondary"
				hx-post="/credentials/recovery"
				hx-target="#recovery"
				hx-swap="outerHTML"
			>
				Neuen Code erzeugen
			</button>
			if v.Error != "" {
				<p class="fail" role="alert">{ v.Error }</p>
			}
		}
	</section>
}

// SignOut makes this browser a stranger again.
//
// It rebuilds the state issue #70 describes, deliberately, and is only
// defensible now that the issue is closed: before the recovery code and the
// PIN, a button that forgot you was a trapdoor with nothing at the bottom.
//
// So the text names the price rather than asking "are you sure", which is a
// question nobody reads. Somebody without a PIN is told what that costs them,
// because they are the one person who should think twice.
//
// A plain form, no HTMX: the page after this is a different page, and a real
// navigation is what makes a cleared cookie take effect in front of somebody
// instead of on their next click.
templ SignOut(v SignOutView) {
	<section class="session">
		<h2>Abmelden</h2>
		<p class="muted">
			Dieses Gerät vergisst dich dann. Andere Geräte, auf denen du
			angemeldet bist, bleiben es.
		</p>
		if v.HasPIN {
			<p class="muted">
				Zum Zurückkommen nimmst du deine PIN oder deinen
				Wiederherstellungscode.
			</p>
		} else {
			<p class="fail">
				Du hast keine PIN. Zum Zurückkommen brauchst du deinen
				Wiederherstellungscode — und wenn du den nicht mehr hast,
				geht es nur noch über den Kiosk.
			</p>
		}
		<form method="post" action="/signout">
			<button class="secondary" type="submit">Auf diesem Gerät abmelden</button>
		</form>
	</section>
}
