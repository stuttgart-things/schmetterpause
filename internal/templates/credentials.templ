package templates

// PINForm is where a player sets or replaces their PIN, on their own profile.
//
// Joining asks for the PIN in the join form itself (docs/adr/0018), so this is
// for changing one, for everybody who joined before that, and for players the
// kiosk created. It swaps itself and nothing else: the card around it is not
// its to replace.
templ PINForm(v PINFormView) {
	<div id="pin-offer" class="pin-offer">
		if v.Done {
			<p class="ok">
				PIN gesetzt. Damit kommst du auf einem neuen Gerät wieder an
				deinen Spieler.
			</p>
		} else {
			<form hx-post="/credentials/pin" hx-target="#pin-offer" hx-swap="outerHTML">
				<label for="pin">{ v.Heading() }</label>
				<p class="muted">
					@pinRule()
					Der Wiederherstellungscode gilt weiter — die PIN ersetzt
					ihn nicht.
				</p>
				<div class="secret-field">
					@pinInput("pin")
					@revealButton("pin")
				</div>
				<button type="submit">{ v.Action() }</button>
				if v.Error != "" {
					<p class="fail" role="alert">{ v.Error }</p>
				}
			</form>
		}
	</div>
}

// pinRule is the sentence beside every field that chooses a PIN: how long it
// has to be, and an example of one.
//
// The example is drawn fresh for every render. A fixed one would be copied,
// and would then be the PIN half the office shares.
//
// It ends on an explicit space: templ drops the whitespace between a
// component and the text that follows it, which ran the full stop into the
// next sentence.
templ pinRule() {
	Mindestens { MinPIN } Ziffern, die du dir merkst — zum Beispiel
	<span class="pin-example">{ PINExample() }</span>.{ " " }
}

// pinInput is a field that chooses a PIN.
//
// inputmode and pattern make a phone show the number pad, and the digits-only
// rule is what keeps this from becoming a field somebody puts their company
// password in (docs/adr/0007).
templ pinInput(id string) {
	<input
		id={ id }
		name="pin"
		type="password"
		inputmode="numeric"
		pattern="[0-9]*"
		autocomplete="new-password"
		minlength={ MinPIN }
		maxlength={ MaxPIN }
		required
	/>
}

// revealButton shows what was typed into a secret field. Six digits or sixteen
// characters typed blind on a phone is how a way back turns into a dead end
// that looks like a wrong secret. Inert without JavaScript, and the field
// still works, so nothing depends on it.
templ revealButton(target string) {
	<button
		type="button"
		class="secret-reveal"
		data-reveal={ target }
		aria-controls={ target }
		aria-pressed="false"
	>
		Zeigen
	</button>
}

// RecoveryCard is the recovery code on somebody's own profile: the way to
// replace it, and the one-time display of what replacing it produced.
//
// It exists because of when it is needed. No kiosk runs in an ordinary week,
// so a way to get a fresh code that only existed on tournament evenings would
// be no way at all from Wednesday to Tuesday (docs/adr/0006).
templ RecoveryCard(v RecoveryCardView) {
	<section id="recovery" class="session recovery-card">
		<h2>Wiederherstellungscode</h2>
		if v.Code != "" {
			<p class="recovery-code"><code>{ v.Code }</code></p>
			<p class="recovery-lead">
				Speicher ihn da, wo deine Passwörter liegen, oder als Datei. Er
				wird <strong>nur dieses eine Mal</strong> angezeigt, und dein
				alter Code gilt ab jetzt nicht mehr.
			</p>
			@recoveryDownload(v.DisplayName, v.Code)
		} else {
			<p class="muted">
				Der Code von deinem ersten Besuch gilt weiter. Wenn du ihn
				verloren hast oder er irgendwo gelandet ist, wo er nicht
				hingehört, erzeug einen neuen — der alte gilt dann sofort
				nicht mehr.
			</p>
			<button
				class="secondary"
				hx-post="/credentials/recovery"
				hx-target="#recovery"
				hx-swap="outerHTML"
			>
				Neuen Code erzeugen
			</button>
			if v.Error != "" {
				<p class="fail" role="alert">{ v.Error }</p>
			}
		}
	</section>
}

// recoveryDownload offers the code on the screen as a text file as well
// (docs/adr/0018).
//
// A data: URL made from the code already in this response, and nothing else.
// There is no endpoint behind it that could hand a code out a second time,
// nothing is kept on the server to serve it from, and there is no link a chat
// preview could follow — which is what docs/adr/0006 held against a link.
// What the same ADR held against a file still holds for a file on its own,
// which is why this sits under the code rather than in its place.
//
// No JavaScript: the download attribute is what turns following it into a
// saved file.
templ recoveryDownload(name, code string) {
	<p class="recovery-download">
		<a class="button-link" href={ recoveryFileURL(name, code) } download={ RecoveryFileName }>
			Als Textdatei speichern
		</a>
	</p>
}

// SignOut makes this browser a stranger again.
//
// It rebuilds the state issue #70 describes, deliberately, and is only
// defensible now that the issue is closed: before the recovery code and the
// PIN, a button that forgot you was a trapdoor with nothing at the bottom.
//
// At the top of your own profile since docs/adr/0018. Below the two cards
// that make it survivable it was in the right order and in a place the
// people looking for it did not find, so the order is now carried by the
// sentence beside it instead: it names the price rather than asking "are you
// sure", which is a question nobody reads, and somebody without a PIN is
// pointed at the card that fixes that first.
//
// A plain form, no HTMX: the page after this is a different page, and a real
// navigation is what makes a cleared cookie take effect in front of somebody
// instead of on their next click.
templ SignOut(v SignOutView) {
	<form class="signout" method="post" action="/signout">
		<button class="secondary" type="submit">Abmelden</button>
		if v.HasPIN {
			<span class="muted">
				Zurück kommst du mit deiner PIN oder deinem
				Wiederherstellungscode.
			</span>
		} else {
			<span class="fail">
				Du hast keine PIN — zurück kämst du nur mit deinem
				Wiederherstellungscode. <a href="#pin-card">Erst eine PIN setzen</a>
			</span>
		}
	</form>
}
