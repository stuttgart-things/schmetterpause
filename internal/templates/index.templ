package templates

import "strconv"

templ Index(v IndexView) {
	@Layout("Start", v.Header) {
		// The wordmark is already in the top bar, so a second one at page size
		// would read as a mistake. The heading stays for anything that
		// navigates by structure rather than by looking.
		<h1 class="sr-only">Schmetterpause &mdash; Büro-Tischtennis</h1>
		@Session(v.Session)
		if v.ShowMatch {
			@PendingList(v.Pending)
			@MatchForm(v.Match)
		}
		@Standings(v.Standings)
		<section
			id="status"
			hx-get="/fragments/status"
			hx-trigger="load, every 10s"
			hx-swap="innerHTML"
		>
			<p class="muted">Status wird geladen …</p>
		</section>
		// Decorative, and the only decoration on the page. It sits at the end
		// where it competes with nothing, and it fills the gap a short table
		// leaves above the footer.
		<img class="page-mascot" src="/static/img/mascot.png" width="420" height="420" alt=""/>
	}
}

// Status is the fragment loaded by HTMX. It proves the path
// handler -> repository -> database and back into the template.
//
// It states what the two probes would answer rather than linking to them: a
// link you have to click and read is not a status, and the footer used to
// carry two of them.
templ Status(v StatusView) {
	<dl class="status">
		<dt>healthz</dt>
		// This fragment came from the process, so the process is alive. That
		// is the whole question liveness asks.
		<dd class="ok">ok</dd>
		<dt>readyz</dt>
		if v.Ready() {
			<dd class="ok">bereit</dd>
		} else {
			<dd class="fail">nicht bereit</dd>
		}
		<dt>Datenbank</dt>
		if v.DatabaseReachable {
			<dd class="ok">erreichbar</dd>
		} else {
			<dd class="fail">nicht erreichbar</dd>
		}
		<dt>Spieler</dt>
		<dd>{ strconv.Itoa(v.Players) }</dd>
		<dt>Version</dt>
		<dd>{ v.Version }</dd>
	</dl>
}
