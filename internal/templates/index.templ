package templates

import (
	"strconv"

	"github.com/stuttgart-things/schmetterpause/web"
)

templ Index(v IndexView) {
	@Layout("Start", v.Header) {
		@PageHead(v.Session)
		// Two ways in, one region. Both render a #session section, so the
		// links inside them keep swapping one for the other in place.
		if v.ShowSignIn {
			@SignIn(v.SignIn)
		} else {
			@Session(v.Session)
		}
		// Both sections stay in the document for a reader nobody is signed
		// in as, empty and unstyled. Joining fills them from the same
		// response that creates the player, and an out-of-band swap can only
		// replace an element that is already there — rendering them only
		// under ShowMatch left a new player with nowhere to enter a result
		// until they reloaded. See issue #75.
		@PendingList(v.Pending)
		if v.ShowMatch {
			@MatchForm(v.Match)
		} else {
			@matchPlaceholder()
		}
		@Standings(v.Standings)
	}
}

// PageHead is the greeting and the drawing beside it.
//
// The wordmark is already in the top bar, so the heading here says something
// the bar does not: who is looking, once anybody is.
templ PageHead(v SessionView) {
	<div id="page-head" class="page-head">
		@pageHeadBody(v)
	</div>
}

// PageHeadOOB is PageHead marked for an out-of-band swap, so joining puts the
// name up there in the same response that creates the player.
templ PageHeadOOB(v SessionView) {
	<div id="page-head" class="page-head" hx-swap-oob="true">
		@pageHeadBody(v)
	</div>
}

// pageHeadBody greets by name and nothing else.
//
// No rating and no rank, tempting as it is: both move whenever a result is
// confirmed anywhere on the page, and every one of those responses would have
// to remember to refresh this corner too. The name is the one thing about a
// player that does not change, and the numbers are in the table below with
// their own row marked.
templ pageHeadBody(v SessionView) {
	<div class="page-greeting">
		if v.SignedIn() {
			<h1>Hallo, { v.DisplayName }</h1>
		} else {
			<h1>Büro-Tischtennis</h1>
			// Says what this is, not what to do next. Which door the card
			// below opens on depends on whether anybody is on the roster
			// yet, and an instruction to type a name is wrong under the
			// picker — where the point is that you do not have to.
			<p class="muted">Ergebnisse eintragen und sehen, wo du stehst.</p>
		}
	</div>
	@PageMascot(PaddleClass(v.PlayerID))
}

// PageMascot is the drawing beside the heading. Decorative and nothing else,
// so the SVG carries aria-hidden and is hidden in print.
//
// Inlined rather than linked. templ.Raw is safe here for the reason it is
// usually not: the string is an asset compiled into this binary, not anything
// that came in with a request.
templ PageMascot(paddle string) {
	// templ.KV rather than the bare string: an empty colour passed straight
	// into the class list renders as class="page-mascot " with a trailing
	// space, which is the sort of thing that is harmless right up until
	// something matches on the attribute.
	<span class={ "page-mascot", templ.KV(paddle, paddle != "") }>
		@templ.Raw(web.Mascot)
	</span>
}

// Status is the fragment loaded by HTMX. It proves the path
// handler -> repository -> database and back into the template.
//
// It states what the two probes would answer rather than linking to them: a
// link you have to click and read is not a status.
//
// It lives on /info rather than under the ranking. What it answers is a
// question somebody asks on purpose — is this thing up, which version is
// running — and it was standing between every player and the bottom of the
// start page to answer it unasked.
templ Status(v StatusView) {
	<dl class="status">
		<dt>healthz</dt>
		// This fragment came from the process, so the process is alive. That
		// is the whole question liveness asks.
		<dd class="ok">ok</dd>
		<dt>readyz</dt>
		if v.Ready() {
			<dd class="ok">bereit</dd>
		} else {
			<dd class="fail">nicht bereit</dd>
		}
		<dt>Datenbank</dt>
		if v.DatabaseReachable {
			<dd class="ok">erreichbar</dd>
		} else {
			<dd class="fail">nicht erreichbar</dd>
		}
		<dt>Spieler</dt>
		<dd>{ strconv.Itoa(v.Players) }</dd>
		<dt>Version</dt>
		<dd>{ v.Version }</dd>
	</dl>
}

// Info is the page the status moved to: what the probes would say, which
// version is running, and how many players there are.
//
// A page rather than a corner of the start page, because it is looked up
// rather than read in passing — and because the start page is what somebody
// opens to enter a result.
templ Info(v StatusView) {
	@Layout("Info", v.Header) {
		<div class="page-head">
			<div class="page-greeting">
				<h1>Info</h1>
				<p class="muted">
					Was die beiden Proben antworten würden, und was gerade läuft.
				</p>
			</div>
		</div>
		<section
			id="status"
			class="card"
			hx-get="/fragments/status"
			hx-trigger="load, every 10s"
			hx-swap="innerHTML"
		>
			<p class="muted">Status wird geladen …</p>
		</section>
	}
}
