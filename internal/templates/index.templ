package templates

import "strconv"

templ Index(session SessionView, players PlayerListView) {
	@Layout("Start") {
		<h1>Schmetterpause</h1>
		<p>
			Ergebniserfassung, Bestätigung und Rangliste folgen mit den
			nächsten Arbeitspaketen.
		</p>
		@Session(session)
		<h2>Spieler</h2>
		@PlayerList(players)
		<section
			id="status"
			hx-get="/fragments/status"
			hx-trigger="load, every 10s"
			hx-swap="innerHTML"
		>
			<p class="muted">Status wird geladen …</p>
		</section>
	}
}

// Status is the fragment loaded by HTMX. It proves the path
// handler -> repository -> database and back into the template.
templ Status(v StatusView) {
	<dl class="status">
		<dt>Datenbank</dt>
		if v.DatabaseReachable {
			<dd class="ok">erreichbar</dd>
		} else {
			<dd class="fail">nicht erreichbar</dd>
		}
		<dt>Spieler</dt>
		<dd>{ strconv.Itoa(v.Players) }</dd>
		<dt>Version</dt>
		<dd>{ v.Version }</dd>
	</dl>
}
