package templates

import "strconv"

// TournamentList is the page that lists tournaments and starts one.
templ TournamentList(v TournamentListView) {
	@Layout("Turniere", v.Header) {
		<section class="card">
			<h2>Turniere</h2>
			if len(v.Tournaments) == 0 {
				<p class="muted">
					Noch keins. Unten eins anlegen — Namen ankreuzen, fertig.
				</p>
			} else {
				<ul class="tournament-list">
					for _, t := range v.Tournaments {
						<li>
							<a href={ templ.SafeURL("/tournaments/" + t.ID) }>{ t.Name }</a>
							<span class="muted">
								{ strconv.Itoa(t.Players) } Spieler,
								{ strconv.Itoa(t.Matches) } Spiele &middot; { t.Mode }
							</span>
							if !t.Open {
								<span class="tag">beendet</span>
							}
						</li>
					}
				</ul>
			}
		</section>
		<section class="card">
			@tournamentForm(v.Form, v.MaxPlayers)
		</section>
	}
}

// tournamentForm starts a tournament: a name and a set of ticks.
//
// Checkboxes rather than a multi-select, because this is read and operated on
// a phone standing next to a table, and a multi-select needs a modifier key
// nobody has there.
templ tournamentForm(v TournamentFormView, maxPlayers int) {
	<h2>Schnelles Turnier</h2>
	if len(v.Candidates) < 2 {
		<p class="muted">
			Dafür braucht es mindestens zwei Spieler in der Rangliste.
		</p>
	} else {
		if v.Error != "" {
			<p class="error" role="alert">{ v.Error }</p>
		}
		<form method="post" action="/tournaments">
			<div class="row">
				<label for="tournament-name">Name</label>
				<input
					id="tournament-name"
					name="name"
					type="text"
					maxlength="60"
					placeholder="Schnelles Turnier"
					value={ v.Name }
				/>
			</div>
			// Asked once, for the whole draw. No HTMX here, unlike result
			// entry: nothing on this form redraws when the mode changes, and
			// the number of set boxes it decides is rendered later, on the
			// schedule.
			<div class="row">
				<label for="tournament-best-of">Modus</label>
				<select id="tournament-best-of" name="best_of">
					for _, n := range BestOfOptions {
						<option value={ strconv.Itoa(n) } selected?={ v.BestOf == n }>
							{ BestOfLabel(n) }
						</option>
					}
				</select>
				<select
					id="tournament-points-to-win"
					name="points_to_win"
					aria-label="Punkte pro Satz"
				>
					for _, p := range PointsToWinOptions {
						<option value={ strconv.Itoa(p) } selected?={ v.PointsToWin == p }>
							bis { strconv.Itoa(p) }
						</option>
					}
				</select>
			</div>
			// Everything that changes the size of the evening redraws the
			// sentence below: the number depends on the names, the format and
			// the final at once, and prose that names one combination is
			// wrong for the other three.
			<div class="row">
				<label for="tournament-format">Runden</label>
				<select
					id="tournament-format"
					name="format"
					hx-get="/fragments/tournament-size"
					hx-target="#tournament-size"
					hx-swap="outerHTML"
					hx-include="closest form"
				>
					<option value="round_robin" selected?={ v.Format != "double_round_robin" }>
						Jeder gegen jeden
					</option>
					<option value="double_round_robin" selected?={ v.Format == "double_round_robin" }>
						Mit Rückspiel
					</option>
				</select>
			</div>
			<label class="tick">
				<input
					type="checkbox"
					name="with_final"
					value="1"
					checked?={ v.WithFinal }
					hx-get="/fragments/tournament-size"
					hx-target="#tournament-size"
					hx-swap="outerHTML"
					hx-include="closest form"
				/>
				Finale zwischen den besten zwei
			</label>
			<fieldset class="tournament-field">
				<legend>Wer spielt mit?</legend>
				for _, c := range v.Candidates {
					<label class="tick">
						<input
							type="checkbox"
							name="player_id"
							value={ c.ID }
							checked?={ c.Chosen }
							hx-get="/fragments/tournament-size"
							hx-target="#tournament-size"
							hx-swap="outerHTML"
							hx-include="closest form"
						/>
						{ c.DisplayName }
					</label>
				}
			</fieldset>
			@TournamentSize(v.Size(maxPlayers))
			<button type="submit">Turnier anlegen</button>
		</form>
	}
}

// TournamentPage is one tournament: the draw, and the table so far.
templ TournamentPage(v TournamentView) {
	@Layout(v.Name, v.Header) {
		<section class="card">
			<h2>{ v.Name }</h2>
			<p class="muted">
				{ TournamentFormatLabel(v.Format, v.WithFinal) } &middot;
				{ TournamentModeLabel(v.BestOf, v.PointsToWin) } &middot;
				{ strconv.Itoa(v.Played) } von { strconv.Itoa(v.Total) } Spielen gewertet.
				if !v.Open {
					Das Turnier ist beendet.
				} else if v.Done() {
					Alle Spiele sind drin.
				}
			</p>
			if v.Open && v.Done() {
				<form method="post" action={ templ.SafeURL("/tournaments/" + v.ID + "/close") }>
					<button type="submit">Turnier beenden</button>
				</form>
			}
			if v.Done() || !v.Open {
				// A second lunch break is a second tournament, not more rounds
				// in this one — the table stays readable and nothing here has
				// to learn a new state. The link only carries the field and
				// the mode; re-ticking eight names is the part nobody does
				// twice.
				<p>
					<a class="button-link" href={ templ.SafeURL("/tournaments?nochmal=" + v.ID) }>
						Nochmal ne Runde
					</a>
				</p>
			}
		</section>
		if v.Error != "" {
			<section class="card">
				<p class="error" role="alert">{ v.Error }</p>
			</section>
		}
		<section class="card">
			<h2>Tabelle</h2>
			@tournamentTable(v.Table)
		</section>
		<section class="card">
			<h2>Spielplan</h2>
			if !v.CanEnter && v.CanReport {
				<p class="muted">
					Deine eigenen Spiele trägst du hier ein — dein Gegner
					bestätigt sie, dann zählen sie. Wer für andere einträgt,
					tut das am freigeschalteten Gerät an der Platte; dort zählt
					es sofort.
				</p>
			} else if !v.CanEnter && v.Open {
				// A link rather than a description of an address. Two people
				// in a row read the old sentence and asked how to get from
				// here to entering a result, which makes it a dead end with a
				// caption rather than a hint.
				//
				// Safe to offer on every device: the kiosk copy renders for
				// anybody, just without the boxes. What it is not is a
				// promise, so the sentence says who it works for.
				if v.OnKioskPath {
					<p class="muted">
						Dieses Gerät ist nicht freigeschaltet — deshalb stehen hier
						keine Eingabefelder. Einmal <code>/kiosk</code> mit dem Token
						öffnen, dann steht das Turnier unter „Offene Turniere".
					</p>
				} else {
					<p class="muted">
						<a href={ templ.SafeURL("/kiosk/tournaments/" + v.ID) }>
							Ergebnisse eintragen
						</a>
						— nur am freigeschalteten Gerät an der Platte. Dort zählen
						sie sofort: bei 28 Spielen wäre eine Bestätigung pro Match
						der halbe Abend.
					</p>
				}
			}
			@tournamentRounds(v)
		</section>
	}
}

templ tournamentTable(rows []TournamentTableRow) {
	if len(rows) == 0 {
		<p class="muted">Noch keine Teilnehmer.</p>
	} else {
		<table class="standings">
			<thead>
				<tr>
					<th scope="col">#</th>
					<th scope="col">Spieler</th>
					<th scope="col">S</th>
					<th scope="col">N</th>
					<th scope="col">Sätze</th>
					<th scope="col">Diff</th>
				</tr>
			</thead>
			<tbody>
				for _, r := range rows {
					<tr>
						<td>
							if r.Ranked() {
								{ strconv.Itoa(r.Rank) }
								if r.Shared {
									<span class="muted" title="geteilter Platz">·</span>
								}
							} else {
								<span class="muted">–</span>
							}
						</td>
						<td>{ r.DisplayName }</td>
						<td>{ strconv.Itoa(r.Won) }</td>
						<td>{ strconv.Itoa(r.Lost) }</td>
						<td>{ r.Sets }</td>
						<td>{ signed(r.SetDiff) }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

templ tournamentRounds(v TournamentView) {
	if len(v.Rounds) == 0 {
		<p class="muted">Zu wenige Teilnehmer für einen Spielplan.</p>
	} else {
		for _, round := range v.Rounds {
			if round.Final {
				<h3>Finale</h3>
			} else {
				<h3>Runde { strconv.Itoa(round.No) }</h3>
			}
			if round.Note != "" {
				// A slot whose names are not settled yet, or one that will not
				// be played. Saying so beats an empty heading, and beats
				// "offen", which would promise a pairing that may never exist.
				<p class="muted">{ round.Note }</p>
			}
			<ul class="pairings">
				for _, p := range round.Pairings {
					<li>
						<span class="pairing-names">{ p.HomeName } – { p.AwayName }</span>
						if p.Played() {
							<span class="pairing-result">{ p.Result }</span>
							if p.Pending {
								<span class="tag">wartet auf Bestätigung</span>
							}
							if p.Disputed {
								<span class="tag">bestritten</span>
							}
						} else if v.CanEnter {
							@pairingEntry("/kiosk/tournaments/"+v.ID+"/matches", v.ID, v.BestOf, v.PointsToWin, p)
						} else if p.CanReport {
							// The same form to the ordinary entry endpoint.
							// It lands as pending and the opponent confirms,
							// exactly like a break-time match (docs/adr/0010).
							@pairingEntry("/matches", v.ID, v.BestOf, v.PointsToWin, p)
						} else {
							<span class="muted">offen</span>
						}
					</li>
				}
				if round.Bye != "" {
					<li class="muted">{ round.Bye } setzt aus</li>
				}
			</ul>
		}
	}
}

// pairingEntry is result entry for one pairing at the table.
//
// The two players and the mode ride along hidden: the draw decided both, and
// a control here would be a chance to enter the right score against the wrong
// pair, or under a mode the rest of the tournament was not played in. The
// server takes the mode from the tournament regardless — these fields are for
// the form to be complete, not for it to be trusted.
//
// One box per set the mode allows: at best of five there are five, at a
// single set there is one. Boxes for sets that cannot exist are boxes
// somebody eventually types into.
//
// A plain form post rather than HTMX: the answer is a redirect back to the
// draw, so a reload cannot re-submit a result that already counted, and a
// kiosk result counts immediately.
templ pairingEntry(action, tournamentID string, bestOf, pointsToWin int, p TournamentPairingView) {
	<form class="pairing-entry" method="post" action={ templ.SafeURL(action) }>
		<input type="hidden" name="tournament_id" value={ tournamentID }/>
		<input type="hidden" name="tournament_round" value={ strconv.Itoa(p.Round) }/>
		<input type="hidden" name="home_id" value={ p.HomeID }/>
		<input type="hidden" name="away_id" value={ p.AwayID }/>
		<input type="hidden" name="best_of" value={ strconv.Itoa(bestOf) }/>
		<input type="hidden" name="points_to_win" value={ strconv.Itoa(pointsToWin) }/>
		for i := 1; i <= bestOf; i++ {
			<span class="pairing-set">
				<label class="sr-only" for={ p.HomeID + "-" + p.AwayID + "-h" + strconv.Itoa(i) }>
					Satz { strconv.Itoa(i) }, { p.HomeName }
				</label>
				<input
					id={ p.HomeID + "-" + p.AwayID + "-h" + strconv.Itoa(i) }
					name={ "set_home_" + strconv.Itoa(i) }
					type="text"
					inputmode="numeric"
					maxlength="2"
					size="2"
				/>
				<span aria-hidden="true">:</span>
				<label class="sr-only" for={ p.HomeID + "-" + p.AwayID + "-a" + strconv.Itoa(i) }>
					Satz { strconv.Itoa(i) }, { p.AwayName }
				</label>
				<input
					id={ p.HomeID + "-" + p.AwayID + "-a" + strconv.Itoa(i) }
					name={ "set_away_" + strconv.Itoa(i) }
					type="text"
					inputmode="numeric"
					maxlength="2"
					size="2"
				/>
			</span>
		}
		<button type="submit">Eintragen</button>
	</form>
}

// signed prints a difference the way a table does: with its sign, so +3 and
// -3 are told apart at a glance rather than by looking for a minus.
func signed(n int) string {
	if n > 0 {
		return "+" + strconv.Itoa(n)
	}
	return strconv.Itoa(n)
}

// TournamentSize says how big the evening is before anybody agrees to it.
//
// Eight players against each other once is 28 matches, which is seven hours at
// a quarter of an hour each — the number the cap on the field exists for. With
// return legs it doubles, and that is exactly why this is computed rather than
// written down.
templ TournamentSize(v TournamentSizeView) {
	<p id="tournament-size" class="muted">
		if v.Players < 2 {
			Mindestens zwei Namen ankreuzen, höchstens { strconv.Itoa(v.MaxPlayers) }.
		} else {
			{ strconv.Itoa(v.Players) } Spieler,
			<strong>{ strconv.Itoa(v.Matches) } Spiele</strong>.
			// Kept on one line with the text before it: an expression that
			// starts its own line here is silently dropped by templ, which
			// compiles and then renders the wrong sentence.
			<span>Bei einer Viertelstunde pro Spiel sind das { TournamentHours(v.Matches) }.</span>
			Höchstens { strconv.Itoa(v.MaxPlayers) } Spieler.
		}
	</p>
}
