package templates

import "strconv"

// TournamentList is the page that lists tournaments and starts one.
templ TournamentList(v TournamentListView) {
	@Layout("Turniere", v.Header) {
		<section class="card">
			<h2>Läuft gerade</h2>
			if len(v.Running) == 0 {
				<p class="muted">
					Keins offen. Unten eins anlegen — Namen ankreuzen, fertig.
				</p>
			} else {
				@tournamentRows(v.Running)
			}
		</section>
		if len(v.Past) > 0 {
			// Folded away, because a finished evening is something somebody
			// looks up on purpose while a running one is what they came for.
			// A details element rather than a second page: no route, no
			// JavaScript, and it works in a browser that has neither.
			<section class="card">
				<details>
					<summary>{ strconv.Itoa(len(v.Past)) } vergangene Turniere</summary>
					@tournamentRows(v.Past)
				</details>
			</section>
		}
		<section class="card">
			@tournamentForm(v.Form, v.MaxPlayers)
		</section>
	}
}

// tournamentRows is one list of tournaments. Running and past look the same
// because they are the same thing at different times; what separates them is
// the heading they stand under.
templ tournamentRows(rows []TournamentListRow) {
	<ul class="tournament-list">
		for _, t := range rows {
			<li>
				<a href={ templ.SafeURL("/tournaments/" + t.ID) }>{ t.Name }</a>
				<span class="muted">
					{ strconv.Itoa(t.Players) } Spieler,
					{ strconv.Itoa(t.Played) } von { strconv.Itoa(t.Matches) } Spielen
					&middot; { t.Mode }
				</span>
				if !t.Rated {
					<span class="unrated">ohne Wertung</span>
				}
				if t.Empty {
					// Only an untouched one. Deleting a tournament with
					// results would leave them behind as casual matches —
					// still rated, and back inside a measurement they were
					// deliberately taken out of.
					<form
						method="post"
						action={ templ.SafeURL("/tournaments/" + t.ID + "/delete") }
					>
						<button class="linklike" type="submit">löschen</button>
					</form>
				}
			</li>
		}
	</ul>
}

// tournamentForm starts a tournament: a name and a set of ticks.
//
// Checkboxes rather than a multi-select, because this is read and operated on
// a phone standing next to a table, and a multi-select needs a modifier key
// nobody has there.
templ tournamentForm(v TournamentFormView, maxPlayers int) {
	<h2>Schnelles Turnier</h2>
	if len(v.Candidates) < 2 {
		<p class="muted">
			Dafür braucht es mindestens zwei Spieler in der Rangliste.
		</p>
	} else {
		@tournamentFields(v, maxPlayers, "/tournaments", TournamentFormCreate)
	}
}

// tournamentFields is the form itself, without the heading around it.
//
// Starting a tournament and changing one that has not been played are the
// same set of questions, so they are the same form. Only where it posts to
// and what the button says differ.
templ tournamentFields(v TournamentFormView, maxPlayers int, action, mode string) {
	if v.Error != "" {
		<p class="error" role="alert">{ v.Error }</p>
	}
	<form method="post" action={ templ.SafeURL(action) }>
		<div class="row">
			<label for="tournament-name">Name</label>
			<input
				id="tournament-name"
				name="name"
				type="text"
				maxlength="60"
				placeholder="Schnelles Turnier"
				value={ v.Name }
			/>
		</div>
		// Asked once, for the whole draw. No HTMX here, unlike result
		// entry: nothing on this form redraws when the mode changes, and
		// the number of set boxes it decides is rendered later, on the
		// schedule.
		// Two pickers in a row say nothing about which is which, so the
		// sentence they sit inside does it: "Best of 3 Sätze, bis 11
		// Punkte". Words rather than two more labels, because the row is
		// already read as one setting.
		<div class="row">
			<label for="tournament-best-of">Modus</label>
			// One sentence, so it wraps as one thing. Without the group the
			// second picker drops to the far left margin on a phone, under
			// the label column, and reads as a setting of its own.
			<span class="row-group">
				<select id="tournament-best-of" name="best_of">
					for _, n := range BestOfOptions {
						<option value={ strconv.Itoa(n) } selected?={ v.BestOf == n }>
							{ BestOfLabel(n) }
						</option>
					}
				</select>
				<span class="row-word">Sätze, bis</span>
				<select
					id="tournament-points-to-win"
					name="points_to_win"
					aria-label="Punkte pro Satz"
				>
					for _, p := range PointsToWinOptions {
						<option value={ strconv.Itoa(p) } selected?={ v.PointsToWin == p }>
							{ strconv.Itoa(p) }
						</option>
					}
				</select>
				<span class="row-word">Punkte</span>
			</span>
		</div>
		// Everything that changes the size of the evening redraws the
		// sentence below: the number depends on the names, the format and
		// the final at once, and prose that names one combination is
		// wrong for the other three.
		<div class="row">
			<label for="tournament-format">Runden</label>
			<select
				id="tournament-format"
				name="format"
				hx-get="/fragments/tournament-size"
				hx-target="#tournament-size"
				hx-swap="outerHTML"
				hx-include="closest form"
			>
				<option value="round_robin" selected?={ v.Format != "double_round_robin" }>
					Jeder gegen jeden
				</option>
				<option value="double_round_robin" selected?={ v.Format == "double_round_robin" }>
					Mit Rückspiel
				</option>
			</select>
			// The final is a property of the draw, so it sits in the same
			// block as the rounds. Directly above "Wer spielt mit?" it read
			// as the first line of the player list.
			<label class="chip">
				<input
					type="checkbox"
					name="with_final"
					value="1"
					checked?={ v.WithFinal }
					hx-get="/fragments/tournament-size"
					hx-target="#tournament-size"
					hx-swap="outerHTML"
					hx-include="closest form"
				/>
				<span>Finale zwischen den besten zwei</span>
			</label>
		</div>
		// An opt-out rather than an opt-in, and not because the wording is
		// nicer: an unticked checkbox sends nothing, so "nothing" has to
		// mean the default, and the default is that a tournament counts
		// (docs/adr/0012).
		<div class="row">
			<label for="tournament-unrated">Wertung</label>
			<label class="chip">
				<input
					id="tournament-unrated"
					type="checkbox"
					name="unrated"
					value="1"
					checked?={ !v.Rated }
				/>
				<span>Zählt nicht für die Rangliste</span>
			</label>
			// An opt-in, unlike the one beside it: its default is off, so an
			// unticked box means what it looks like it means.
			<label class="chip">
				<input
					type="checkbox"
					name="count_points"
					value="1"
					checked?={ v.CountPoints }
				/>
				<span>Tabelle in Punkten (3 pro Sieg)</span>
			</label>
		</div>
		// Carried so the redrawn button below can say the right thing
		// without the fragment being told a label to print.
		<input type="hidden" name="form_mode" value={ mode }/>
		<fieldset class="tournament-field">
			<legend>
				Wer spielt mit?
				// Beside the question rather than under the answer: how many
				// are ticked is what somebody wants to know while ticking.
				@TournamentCount(v.Size(maxPlayers), nil)
			</legend>
			for _, c := range v.Candidates {
				<label class="chip">
					<input
						type="checkbox"
						name="player_id"
						value={ c.ID }
						checked?={ c.Chosen }
						hx-get="/fragments/tournament-size"
						hx-target="#tournament-size"
						hx-swap="outerHTML"
						hx-include="closest form"
					/>
					<span>{ c.DisplayName }</span>
				</label>
			}
		</fieldset>
		@TournamentSize(v.Size(maxPlayers))
		@TournamentSubmit(v.Size(maxPlayers), mode, nil)
	</form>
}

// TournamentPage is one tournament: the draw, and the table so far.
templ TournamentPage(v TournamentView) {
	@Layout(v.Name, v.Header) {
		<section class="card">
			<h2>{ v.Name }</h2>
			<p class="muted">
				{ TournamentFormatLabel(v.Format, v.WithFinal) } &middot;
				{ TournamentModeLabel(v.BestOf, v.PointsToWin) } &middot;
				{ strconv.Itoa(v.Played) } von { strconv.Itoa(v.Total) } Spielen gewertet.
				if !v.Rated {
					// Where somebody would otherwise find out afterwards.
					<strong class="unrated">Zählt nicht für die Rangliste.</strong>
				}
				if !v.Open {
					Das Turnier ist beendet.
				} else if v.Done() {
					Alle Spiele sind drin.
				}
			</p>
			if v.Open {
				// Not only when every match is in. A tournament nobody ever
				// finishes is the one that most needs taking off the list,
				// and hiding the button until it is complete left exactly
				// those standing open forever. Nothing about the rating hangs
				// on this (docs/adr/0009).
				<form method="post" action={ templ.SafeURL("/tournaments/" + v.ID + "/close") }>
					<button class="secondary" type="submit">Turnier beenden</button>
					if !v.Done() {
						<span class="muted">
							Es fehlen noch Spiele — beendet steht es trotzdem
							unter „vergangene Turniere".
						</span>
					}
				</form>
			}
			if v.Open && v.Started {
				// Said here because the place it used to be said — inside
				// "Turnier ändern" — is gone from the moment it becomes
				// true. Somebody looking for where to add a latecomer finds
				// the answer instead of an absence.
				<p class="muted">
					Das Feld steht fest, seit das erste Ergebnis drin ist. Wer
					jetzt noch dazu will, ist beim nächsten Turnier dabei — ein
					Spielplan, der sich nachträglich verschiebt, legt
					eingetragene Ergebnisse in Runden, in denen sie nicht
					gespielt wurden.
				</p>
			}
			if v.Done() || !v.Open {
				// A second lunch break is a second tournament, not more rounds
				// in this one — the table stays readable and nothing here has
				// to learn a new state. The link only carries the field and
				// the mode; re-ticking eight names is the part nobody does
				// twice.
				<p>
					<a class="button-link" href={ templ.SafeURL("/tournaments?nochmal=" + v.ID) }>
						Nochmal ne Runde
					</a>
				</p>
			}
		</section>
		if v.Error != "" {
			<section class="card">
				<p class="error" role="alert">{ v.Error }</p>
			</section>
		}
		if v.Edit != nil {
			// Only while nothing has been played, and folded away, because
			// the ordinary reason to open a draw is to read it rather than to
			// change it.
			<section class="card">
				<details>
					<summary>Turnier ändern</summary>
					<p class="muted">
						Geht, solange kein Ergebnis drin steht. Danach liegt der
						Spielplan fest — ein Feld, das sich nachträglich
						verschiebt, würde eingetragene Ergebnisse in Runden
						legen, in denen sie nicht gespielt wurden.
					</p>
					@tournamentFields(*v.Edit, v.MaxPlayers, "/tournaments/"+v.ID+"/edit", TournamentFormEdit)
					<form method="post" action={ templ.SafeURL("/tournaments/" + v.ID + "/delete") }>
						<button class="linklike" type="submit">Turnier löschen</button>
					</form>
				</details>
			</section>
		}
		<section class="card">
			<h2>Tabelle</h2>
			@tournamentTable(v.Table, v.CountPoints)
			if len(v.Table) > 0 {
				@tieBreaks(v.SharedRank(), v.CountPoints)
			}
		</section>
		<section class="card">
			<h2>Spielplan</h2>
			if !v.CanEnter && v.CanReport {
				<p class="muted">
					Deine eigenen Spiele trägst du hier ein — dein Gegner
					bestätigt sie, dann zählen sie. Wer für andere einträgt,
					tut das am freigeschalteten Gerät an der Platte; dort zählt
					es sofort.
				</p>
			} else if !v.CanEnter && v.Open {
				// A link rather than a description of an address. Two people
				// in a row read the old sentence and asked how to get from
				// here to entering a result, which makes it a dead end with a
				// caption rather than a hint.
				//
				// Safe to offer on every device: the kiosk copy renders for
				// anybody, just without the boxes. What it is not is a
				// promise, so the sentence says who it works for.
				if v.OnKioskPath {
					<p class="muted">
						Dieses Gerät ist nicht freigeschaltet — deshalb stehen hier
						keine Eingabefelder. Einmal <code>/kiosk</code> mit dem Token
						öffnen, dann steht das Turnier unter „Offene Turniere".
					</p>
				} else {
					<p class="muted">
						<a href={ templ.SafeURL("/kiosk/tournaments/" + v.ID) }>
							Ergebnisse eintragen
						</a>
						— nur am freigeschalteten Gerät an der Platte. Dort zählen
						sie sofort: bei 28 Spielen wäre eine Bestätigung pro Match
						der halbe Abend.
					</p>
				}
			}
			@tournamentRounds(v)
		</section>
	}
}

// tieBreaks states the order in which a level table is decided.
//
// Written down because it is the thing an office argues about instead of
// playing: at six to twelve players a round robin produces a tie almost every
// time, and a rule nobody can read is a rule everybody has an opinion on. It
// is not configurable and not meant to be — the point of a fixed order is
// that it was fixed before anybody knew who it would favour.
//
// Folded away while it is background, and open by itself the moment two
// players actually share a place.
templ tieBreaks(shared, points bool) {
	<details class="tiebreak" open?={ shared }>
		<summary>Wenn zwei gleich stehen</summary>
		<ol>
			if points {
				<li>Punkte</li>
			} else {
				<li>Siege</li>
			}
			<li>Direkter Vergleich &mdash; bei mehr als zweien die Spiele dieser Gruppe untereinander</li>
			<li>Satzdifferenz</li>
			<li>Ballpunktdifferenz</li>
		</ol>
		<p class="muted">
			Bleibt es auch dann gleich, teilen sich die Plätze in der Tabelle.
			Wer den Pokal nimmt, entscheidet ein Satz bis 11 an der Platte
			&mdash; nicht das Los.
		</p>
	</details>
}

templ tournamentTable(rows []TournamentTableRow, points bool) {
	if len(rows) == 0 {
		<p class="muted">Noch keine Teilnehmer.</p>
	} else {
		<table class="standings">
			<thead>
				<tr>
					<th scope="col">#</th>
					<th scope="col">Spieler</th>
					if points {
						// Beside the wins rather than instead of them: the
						// number is three times the one next to it, and a
						// column that replaced it would hide the count it is
						// made of.
						<th scope="col">Pkt</th>
					}
					<th scope="col">S</th>
					<th scope="col">N</th>
					<th scope="col">Sätze</th>
					<th scope="col">Diff</th>
				</tr>
			</thead>
			<tbody>
				for _, r := range rows {
					<tr>
						<td>
							if r.Ranked() {
								{ strconv.Itoa(r.Rank) }
								if r.Shared {
									<span class="muted" title="geteilter Platz">·</span>
								}
							} else {
								<span class="muted">–</span>
							}
						</td>
						<td>{ r.DisplayName }</td>
						if points {
							<td><strong>{ strconv.Itoa(r.Points) }</strong></td>
						}
						<td>{ strconv.Itoa(r.Won) }</td>
						<td>{ strconv.Itoa(r.Lost) }</td>
						<td>{ r.Sets }</td>
						<td>{ signed(r.SetDiff) }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

templ tournamentRounds(v TournamentView) {
	if len(v.Rounds) == 0 {
		<p class="muted">Zu wenige Teilnehmer für einen Spielplan.</p>
	} else {
		for _, round := range v.Rounds {
			if round.Final {
				<h3>Finale</h3>
			} else {
				<h3>Runde { strconv.Itoa(round.No) }</h3>
			}
			if round.Note != "" {
				// A slot whose names are not settled yet, or one that will not
				// be played. Saying so beats an empty heading, and beats
				// "offen", which would promise a pairing that may never exist.
				<p class="muted">{ round.Note }</p>
			}
			<ul class="pairings">
				for _, p := range round.Pairings {
					<li>
						<span class="pairing-names">{ p.HomeName } – { p.AwayName }</span>
						if p.Played() {
							<span class="pairing-result">{ p.Result }</span>
							if p.Pending {
								<span class="tag">wartet auf Bestätigung</span>
							}
							if p.Disputed {
								<span class="tag">bestritten</span>
							}
						} else if v.CanEnter {
							@pairingEntry("/kiosk/tournaments/"+v.ID+"/matches", v.ID, v.BestOf, v.PointsToWin, p)
						} else if p.CanReport {
							// The same form to the ordinary entry endpoint.
							// It lands as pending and the opponent confirms,
							// exactly like a break-time match (docs/adr/0010).
							@pairingEntry("/matches", v.ID, v.BestOf, v.PointsToWin, p)
						} else {
							<span class="muted">offen</span>
						}
					</li>
				}
				if round.Bye != "" {
					<li class="muted">{ round.Bye } setzt aus</li>
				}
			</ul>
		}
	}
}

// pairingEntry is result entry for one pairing at the table.
//
// The two players and the mode ride along hidden: the draw decided both, and a
// control here would be a chance to enter the right score against the wrong
// pair, or under a mode the rest of the tournament was not played in. The
// server takes both from the tournament regardless — these fields are for the
// form to be complete, not for it to be trusted.
//
// The boxes are the ordinary ones, from the ordinary form. This used to be a
// row of six identical fields with two colons in it: no set numbers, no
// heading saying whose column is whose, and no sliders — all three of which
// setRows has, and for reasons that apply at a tournament table more than
// anywhere else.
//
// Folded, because a schedule is read far more often than it is typed into,
// and eight players is twenty-eight of these. A details element rather than a
// swap: no route, no JavaScript, and the rule text arrives exactly when
// somebody is about to need it.
//
// A plain form post rather than HTMX: the answer is a redirect back to the
// draw, so a reload cannot re-submit a result that already counted, and a
// kiosk result counts immediately.
templ pairingEntry(action, tournamentID string, bestOf, pointsToWin int, p TournamentPairingView) {
	<details class="pairing-entry">
		<summary>Ergebnis eintragen</summary>
		<form method="post" action={ templ.SafeURL(action) }>
			<input type="hidden" name="tournament_id" value={ tournamentID }/>
			<input type="hidden" name="tournament_round" value={ strconv.Itoa(p.Round) }/>
			<input type="hidden" name="home_id" value={ p.HomeID }/>
			<input type="hidden" name="away_id" value={ p.AwayID }/>
			<input type="hidden" name="best_of" value={ strconv.Itoa(bestOf) }/>
			<input type="hidden" name="points_to_win" value={ strconv.Itoa(pointsToWin) }/>
			// The prefix keeps every id on the page unique. Twenty-eight
			// pairings share this template, and two fields with one id is a
			// label that points at the wrong box.
			@setRows("t"+strconv.Itoa(p.Round)+"-"+p.HomeID, EmptySets(),
				bestOf, pointsToWin, p.HomeName, p.AwayName)
			<button type="submit">Eintragen</button>
		</form>
	</details>
}

// signed prints a difference the way a table does: with its sign, so +3 and
// -3 are told apart at a glance rather than by looking for a minus.
func signed(n int) string {
	if n > 0 {
		return "+" + strconv.Itoa(n)
	}
	return strconv.Itoa(n)
}

// TournamentSize says how big the evening is before anybody agrees to it.
//
// Eight players against each other once is 28 matches, which is seven hours at
// a quarter of an hour each — the number the cap on the field exists for. With
// return legs it doubles, and that is exactly why this is computed rather than
// written down.
// TournamentCount is the tally beside "Wer spielt mit?".
//
// Out of band: it belongs next to the question and the swap that redraws it
// targets the sentence under the answer, so it rides along with that response
// rather than needing a second request.
templ TournamentCount(v TournamentSizeView, oob templ.Attributes) {
	<span id="tournament-count" class="field-count" { oob... }>
		{ strconv.Itoa(v.Players) } von höchstens { strconv.Itoa(v.MaxPlayers) }
	</span>
}

// TournamentSubmit is the button, disabled until the form describes a
// tournament that could exist.
//
// The mode rather than the label travels with the form, so the fragment picks
// its own words from a fixed set instead of printing back whatever a request
// asked it to.
templ TournamentSubmit(v TournamentSizeView, mode string, oob templ.Attributes) {
	<button id="tournament-submit" type="submit" disabled?={ !v.Enough() } { oob... }>
		{ TournamentSubmitLabel(mode) }
	</button>
}

templ TournamentSize(v TournamentSizeView) {
	<p id="tournament-size" class="muted">
		if v.Players < 2 {
			// The count and the cap are beside the question now, so this
			// says the one thing they do not: why the button is off.
			Der Knopf wird frei, sobald zwei Namen angekreuzt sind.
		} else {
			{ strconv.Itoa(v.Players) } Spieler,
			<strong>{ strconv.Itoa(v.Matches) } Spiele</strong>.
			// Kept on one line with the text before it: an expression that
			// starts its own line here is silently dropped by templ, which
			// compiles and then renders the wrong sentence.
			<span>Bei einer Viertelstunde pro Spiel sind das { TournamentHours(v.Matches) }.</span>
		}
	</p>
}
