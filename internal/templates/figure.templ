package templates

// FigureEditor is where a player assembles their figure (docs/adr/0029). On
// their own profile only, under the rating.
//
// Every change asks the server for the figure as it would look and puts it
// in the preview; nothing is stored until "Speichern". HTMX rather than a
// line of JavaScript, because the server is what knows how a figure is put
// together (invariant 7).
templ FigureEditor(v FigureEditorView) {
	<section id="figure-editor" class="session figure-card">
		<h2>Deine Figur</h2>
		<p class="muted">
			Du wählst deine Figur, ihre Farben und den Schläger. Dazu kannst du Schmuck wählen. Das Gesicht folgt dem Spielstand am Zählwerk.
		</p>
		<form hx-post="/figure" hx-target="#figure-editor" hx-swap="outerHTML" hx-sync="this:replace">
			if v.NoHeaddress {
				<input type="hidden" name="headdress" value="fur"/>
			}
			<fieldset
				class="figure-part character-picker"
				hx-get="/fragments/figure-character"
				hx-sync="closest form:replace"
				hx-trigger="change"
				hx-include="closest form"
				hx-target="#figure-editor"
				hx-swap="outerHTML"
			>
				<legend>Deine Spielfigur</legend>
				for _, ch := range v.Characters {
					<label class="pick character-pick">
						<input id={ "character-" + ch.Key } type="radio" name="character" value={ ch.Key } checked?={ ch.Checked }/>
						<span><span id={ "character-thumbnail-" + ch.Key } class="character-thumbnail">@templ.Raw(ch.Preview)</span>{ ch.Name }</span>
					</label>
				}
			</fieldset>
			@FigureExpressions(v.Expressions, false)
			<div class="figure-layout">
				<div id="figure-preview" class="figure-preview">
					@templ.Raw(v.Preview)
				</div>
				// The change trigger sits on the parts rather than on the form,
				// so the form keeps its own submit for "Speichern".
				<div
					class="figure-parts"
					hx-get="/fragments/figure-preview"
					hx-sync="closest form:replace"
					hx-trigger="change"
					hx-include="closest form"
					hx-target="#figure-preview"
					hx-swap="innerHTML"
				>
					for _, part := range v.Parts {
						<fieldset class="figure-part">
							<legend>{ part.Label }</legend>
							for _, o := range part.Options {
								<label class="pick">
									<input type="radio" name={ part.Name } value={ o.Key } checked?={ o.Checked }/>
									<span>
										if o.Hex != "" {
											<i class="swatch" style={ "background:" + o.Hex }></i>
										} else if o.SameAsFur {
											<i class="swatch swatch-fur"></i>
										}
										{ o.Name }
									</span>
								</label>
							}
						</fieldset>
					}
					@FigureBallColor(v.BallColor, false)
				</div>
			</div>
			<div class="figure-actions">
				<button type="submit">Speichern</button>
				<button
					type="button"
					class="secondary"
					hx-get="/fragments/figure-roll"
					hx-target="#figure-editor"
					hx-swap="outerHTML"
				>Würfeln</button>
				<button
					type="button"
					class="secondary"
					hx-post="/figure/reset"
					hx-target="#figure-editor"
					hx-swap="outerHTML"
				>Zurücksetzen</button>
			</div>
			switch  {
				case v.Error != "":
					<p class="fail" role="alert">{ v.Error }</p>
				case v.Saved:
					<p class="ok" role="status">Gespeichert. So sehen dich jetzt alle.</p>
				case v.Reset:
					<p class="ok" role="status">Zurückgesetzt auf die Figur, mit der du angefangen hast.</p>
				case v.Rolled:
					<p class="muted" role="status">Gewürfelt, noch nicht gespeichert.</p>
			}
		</form>
	</section>
}

// FigurePreview is the figure as it would look, for the box in the editor.
templ FigurePreview(svg string) {
	@templ.Raw(svg)
}

// FigureExpressions is a read-only gallery, also updated out of band when
// colours change in the editor. Each preview contains exactly one face.
templ FigureExpressions(v FigureExpressionsView, oob bool) {
	<section
		id="figure-expressions"
		class="figure-expressions"
		if oob {
			hx-swap-oob="true"
		}
	>
		<h3>Gesichtsausdrücke: { v.CharacterName }</h3>
		<p class="muted">Mit deinen aktuellen Farben. Im Spiel bestimmt der Spielstand den Ausdruck.</p>
		<div class="face-grid">
			for _, f := range v.Faces {
				<figure class="face-preview" data-expression={ f.Key }>
					@templ.Raw(f.Preview)
					<figcaption>{ f.Name }</figcaption>
				</figure>
			}
		</div>
	</section>
}

// ProfileFigure is the figure beside the name on a profile. With an id, so
// saving in the editor can replace it out of band and the head shows the new
// figure in the same response.
templ ProfileFigure(svg, blade string, oob bool) {
	<span
		id="profile-figure"
		class={ "page-mascot", templ.KV(blade, blade != "") }
		if oob {
			hx-swap-oob="true"
		}
	>
		@templ.Raw(svg)
	</span>
}

// Update only the selected thumbnail after a material or jewellery change.
templ FigureSelectedThumbnail(svg, key string) {
	<span id={ "character-thumbnail-" + key } class="character-thumbnail" hx-swap-oob="true">@templ.Raw(svg)</span>
}

// FigureBallColor swaps out of band when the accessory changes.
templ FigureBallColor(v FigureBallColorView, oob bool) {
	<div
		id="figure-ball-color"
		if oob {
			hx-swap-oob="true"
		}
	>
		if v.Active {
			<fieldset class="figure-part">
				<legend>Ballfarbe</legend>
				for _,o:= range v.Options {
					<label class="pick"><input type="radio" name="ballColor" value={ o.Key } checked?={ o.Checked }/><span><i class="swatch" style={ "background:" + o.Hex }></i>{ o.Name }</span></label>
				}
			</fieldset>
		} else {
			<input type="hidden" name="ballColor" value={ v.Value }/>
		}
	</div>
}
