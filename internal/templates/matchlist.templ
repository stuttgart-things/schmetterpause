package templates

import "strconv"

// MatchList is every match the office has played.
//
// The ranking says who is ahead; this says what happened. Same table shape as
// the profile's match list, because it is the same data without the filter to
// one player — somebody who has read one has read both.
templ MatchList(v MatchListView) {
	@Layout("Matches", v.Header) {
		<div class="page-head">
			<div class="page-greeting">
				<h1>Matches</h1>
				if v.Filter.All {
					<p class="muted">Alles, was an der Platte passiert ist — neueste zuerst.</p>
				} else {
					// Says whose these are without making anybody read the
					// picker: somebody who followed a link has to know what
					// they are looking at.
					<p class="muted">
						Alles, was { v.Filter.Name } gespielt hat — neueste zuerst.
					</p>
				}
			</div>
			// The list belongs to everybody, so it has a colour of its own.
			@PageMascot(PaddleMatchList)
		</div>
		<section id="matches">
			// A plain GET form. The answer is a whole page at an address
			// somebody can keep and send — "schau dir mal meine Matches an"
			// is a link, not an instruction — and a form that navigates needs
			// no JavaScript at all. An onchange handler would be the only
			// inline script in the project (invariant 7); HTMX could do it,
			// but only by swapping the page into itself for a plain link.
			<form class="match-filter" method="get" action="/matches">
				<label for="match-filter">Wessen Matches</label>
				<select id="match-filter" name="spieler">
					<option value={ MatchFilterAll } selected?={ v.Filter.All }>alle</option>
					for _, p := range v.Filter.Players {
						<option value={ p.ID } selected?={ p.Selected }>{ p.DisplayName }</option>
					}
				</select>
				<button class="secondary" type="submit">Anzeigen</button>
			</form>
			if len(v.Matches) == 0 {
				if v.Filter.All {
					<p class="muted">Noch nichts eingetragen.</p>
				} else {
					<p class="muted">
						Für { v.Filter.Name } ist noch nichts eingetragen.
					</p>
				}
			} else {
				// Same reasoning as the ranking: the table scrolls in its own
				// box rather than taking the page with it. Focusable, because
				// a scrolling region a keyboard cannot reach is one it cannot
				// read either.
				<div class="table-scroll" tabindex="0" role="region" aria-label="Alle Matches">
					<table class="matches">
						<thead>
							<tr>
								<th scope="col">Wann</th>
								<th scope="col">Sieger</th>
								<th scope="col">Gegner</th>
								<th scope="col" class="num">Sätze</th>
								// TTR before the set-by-set detail, unlike the profile's
								// table: this one has a second name column and does not fit
								// a phone. Whether a match counted is what a reader is here
								// for, so the wide column is the one that scrolls out of
								// sight rather than that one.
								<th scope="col" class="num">TTR</th>
								<th scope="col">Verlauf</th>
							</tr>
						</thead>
						<tbody>
							for _, m := range v.Matches {
								// Won or lost, from the side of whoever the list
								// is about. Redundant with the two name columns
								// on purpose: nothing here is carried by colour
								// alone, the stripe only saves the reading.
								<tr class={ templ.KV("match-won", m.SubjectWon), templ.KV("match-lost", m.SubjectLost) }>
									<td class="when">{ m.PlayedAt }</td>
									<td class="name">
										<a href={ templ.SafeURL("/players/" + m.WinnerID) }>{ m.WinnerName }</a>
									</td>
									<td class="name">
										<a href={ templ.SafeURL("/players/" + m.LoserID) }>{ m.LoserName }</a>
									</td>
									<td class="num score">
										{ strconv.Itoa(m.WinnerSets) }:{ strconv.Itoa(m.LoserSets) }
										@matchState(m.Pending, m.Disputed)
									</td>
									<td class="num">
										// Whose change this is. The colour and the
										// sign say it to somebody looking at the
										// row; this says it to somebody who is
										// hearing it.
										if m.SubjectName != "" {
											<span class="sr-only">{ m.SubjectName }: </span>
										}
										@matchDelta(m.Pending, m.Disputed, m.HasDelta, m.Delta)
									</td>
									<td class="sets-line">
										for i, s := range m.Sets {
											if i > 0 {
												{ ", " }
											}
											{ strconv.Itoa(s.Own) }:{ strconv.Itoa(s.Opponent) }
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				if v.Truncated {
					<p class="muted">
						Es werden die letzten { strconv.Itoa(v.Limit) } Matches gezeigt. Ältere
						stehen in der Datenbank und brauchen eine Seitennavigation, die es
						noch nicht gibt.
					</p>
				}
			}
		</section>
	}
}

// matchState is the badge beside the set score, and it is the answer to issue
// #76.
//
// The state used to stand *in place of* the rating change, in the TTR column,
// with the explanation in a title attribute. Two things were wrong with that.
// A row waiting for your confirmation looked like a row whose rating simply
// had not moved, which is what somebody read it as on the row that mattered to
// them. And a title attribute is invisible on a phone, because a phone has no
// hover — and this table is read on a phone.
//
// Beside the score rather than in a column of its own: the list already
// carries six columns, and at 390px only Verlauf may leave the box (#51, #63).
// A seventh is not free, and the badge sits where the eye already is.
//
// The profile's match list uses this too. The same three states appeared
// there, and one of them being explained differently would be worse than
// either wording.
templ matchState(pending, disputed bool) {
	if disputed {
		<span class="state state-disputed" title="Widersprochen, zählt nicht">strittig</span>
	} else if pending {
		<span class="state state-pending" title="Wartet auf Bestätigung">offen</span>
	}
}

// matchDelta is the TTR cell, and now numbers only.
//
// A dash for anything unsettled rather than a word: the word is on the badge,
// and a match that has not counted has no rating change to show. "±0" is kept
// for the settled ones that really did move nothing, which happens whenever a
// strong favourite beats somebody they were expected to beat.
templ matchDelta(pending, disputed, hasDelta bool, delta int) {
	if pending || disputed {
		<span class="muted" aria-label="noch keine Wertung">&ndash;</span>
	} else if !hasDelta {
		// Settled and no history row: a match in a tournament that does not
		// count (docs/adr/0012). settle writes both rows or neither, so the
		// absence is the answer rather than a guess. "±0" below is for the
		// ones that were rated and really did move nothing.
		<span class="muted" aria-label="nicht gewertet">&ndash;</span>
	} else if hasDelta && delta > 0 {
		<span class="gain">+{ strconv.Itoa(delta) }</span>
	} else if delta < 0 {
		<span class="loss">{ strconv.Itoa(delta) }</span>
	} else {
		<span class="muted">&plusmn;0</span>
	}
}
