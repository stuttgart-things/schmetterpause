package templates

import "strconv"

// MatchList is every match the office has played.
//
// The ranking says who is ahead; this says what happened. Same table shape as
// the profile's match list, because it is the same data without the filter to
// one player — somebody who has read one has read both.
templ MatchList(v MatchListView) {
	@Layout("Matches", v.Header) {
		<div class="page-head">
			<div class="page-greeting">
				<h1>Matches</h1>
				<p class="muted">Alles, was an der Platte passiert ist — neueste zuerst.</p>
			</div>
			// No colour: the list belongs to everybody.
			@PageMascot("")
		</div>
		<section id="matches">
			if len(v.Matches) == 0 {
				<p class="muted">Noch nichts eingetragen.</p>
			} else {
				// Same reasoning as the ranking: the table scrolls in its own
				// box rather than taking the page with it. Focusable, because
				// a scrolling region a keyboard cannot reach is one it cannot
				// read either.
				<div class="table-scroll" tabindex="0" role="region" aria-label="Alle Matches">
					<table class="matches">
						<thead>
							<tr>
								<th scope="col">Wann</th>
								<th scope="col">Sieger</th>
								<th scope="col">Gegner</th>
								<th scope="col" class="num">Sätze</th>
								// TTR before the set-by-set detail, unlike the profile's
								// table: this one has a second name column and does not fit
								// a phone. Whether a match counted is what a reader is here
								// for, so the wide column is the one that scrolls out of
								// sight rather than that one.
								<th scope="col" class="num">TTR</th>
								<th scope="col">Verlauf</th>
							</tr>
						</thead>
						<tbody>
							for _, m := range v.Matches {
								<tr>
									<td class="when">{ m.PlayedAt }</td>
									<td class="name">
										<a href={ templ.SafeURL("/players/" + m.WinnerID) }>{ m.WinnerName }</a>
									</td>
									<td class="name">
										<a href={ templ.SafeURL("/players/" + m.LoserID) }>{ m.LoserName }</a>
									</td>
									<td class="num">
										{ strconv.Itoa(m.WinnerSets) }:{ strconv.Itoa(m.LoserSets) }
									</td>
									<td class="num">
										// Same three states as the profile, and for the same
										// reason: a match that is not settled has no rating
										// change, and "±0" would claim it moved nothing.
										if m.Disputed {
											<span class="muted" title="Widersprochen, zählt nicht">strittig</span>
										} else if m.Pending {
											<span class="muted" title="Wartet auf Bestätigung">offen</span>
										} else if m.HasDelta && m.Delta > 0 {
											<span class="gain">+{ strconv.Itoa(m.Delta) }</span>
										} else if m.HasDelta && m.Delta < 0 {
											<span class="loss">{ strconv.Itoa(m.Delta) }</span>
										} else {
											<span class="muted">±0</span>
										}
									</td>
									<td class="sets-line">
										for i, s := range m.Sets {
											if i > 0 {
												{ ", " }
											}
											{ strconv.Itoa(s.Own) }:{ strconv.Itoa(s.Opponent) }
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				if v.Truncated {
					<p class="muted">
						Es werden die letzten { strconv.Itoa(v.Limit) } Matches gezeigt. Ältere
						stehen in der Datenbank und brauchen eine Seitennavigation, die es
						noch nicht gibt.
					</p>
				}
			}
		</section>
	}
}
