package templates

import "strconv"

// Standings renders the ranking.
//
// A table, not a chart: this is a handful of rows people scan for their own
// name and the one above it. Numbers get tabular figures so the columns line
// up while ratings move.
templ Standings(v StandingsView) {
	<section id="standings" class="standings">
		@standingsHead()
		@standingsBody(v)
	</section>
}

// StandingsOOB is Standings marked for an out-of-band swap, so a confirmation
// can refresh the ranking in the same response that settles the match.
templ StandingsOOB(v StandingsView) {
	<section id="standings" class="standings" hx-swap-oob="true">
		@standingsHead()
		@standingsBody(v)
	</section>
}

// standingsHead is the heading and the way to bring the page up to date.
//
// The ranking only ever changed when the reader themselves did something —
// somebody else's confirmed match sat there unseen until a reload. The button
// answers that, and it fetches the pending list and the badge along with it,
// because those go stale for the same reason and pressing three things to
// catch up would be a worse answer than pressing none.
//
// hx-swap="none": everything in the response is swapped out of band, so there
// is nothing to put where the button is. hx-disabled-elt stops an impatient
// second press from queueing a second round trip.
templ standingsHead() {
	<div class="standings-head">
		<h2>Rangliste</h2>
		<button
			class="secondary refresh"
			hx-get="/fragments/refresh"
			hx-swap="none"
			hx-disabled-elt="this"
		>
			Aktualisieren
		</button>
	</div>
}

templ standingsBody(v StandingsView) {
	if len(v.Rows) == 0 {
		<p class="muted">Noch niemand da.</p>
	} else {
		// The table cannot shrink below the width its content needs, so it
		// scrolls in its own box rather than pushing the page sideways. The
		// box is focusable because a scrolling region a keyboard cannot reach
		// is a region a keyboard cannot read.
		<div class="table-scroll" tabindex="0" role="region" aria-label="Rangliste">
			<table>
				<thead>
					<tr>
						<th scope="col">#</th>
						<th scope="col">Spieler</th>
						<th scope="col" class="num">TTR</th>
						<th scope="col" class="num">Spiele</th>
						<th scope="col" class="num">Bilanz</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range v.Rows {
						<tr class={ templ.KV("self", row.IsSelf) }>
							<td class="rank-cell">
								if !row.Ranked() {
									<span class={ rankClass(0, false) } title="noch kein gewertetes Spiel">&ndash;</span>
								} else if row.Shared {
									<span class={ rankClass(row.Rank, true) } title="geteilter Platz">
										{ strconv.Itoa(row.Rank) }
									</span>
								} else {
									<span class={ rankClass(row.Rank, false) }>{ strconv.Itoa(row.Rank) }</span>
								}
							</td>
							<td class="name">
								<a href={ templ.SafeURL("/players/" + row.ID) }>{ row.DisplayName }</a>
								if row.IsSelf {
									<span class="muted">(du)</span>
								}
							</td>
							<td class="num">{ strconv.Itoa(row.TTR) }</td>
							<td class="num">{ strconv.Itoa(row.Played) }</td>
							<td class="num">
								if row.Played == 0 {
									<span class="muted">–</span>
								} else {
									{ strconv.Itoa(row.Won) }:{ strconv.Itoa(row.Lost) }
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if !v.AnyRanked() {
			<p class="muted standings-empty">
				Noch kein gewertetes Spiel &mdash; darum steht niemand auf
				einem Platz. Sei der Erste.
			</p>
		}
	}
}
