package templates

import "strconv"

// PendingList shows the results waiting on the viewer's word.
//
// Only the opponent can decide, never whoever entered the result — that is
// the whole point of the step, and the reason it is the app's real defence
// against a joke score rather than the login is.
templ PendingList(v PendingListView) {
	<section id="pending" class={ templ.KV("pending", len(v.Matches) > 0) }>
		@pendingItems(v)
	</section>
}

// PendingListOOB is PendingList marked for an out-of-band swap, so an action
// elsewhere on the page can refresh it in the same response.
templ PendingListOOB(v PendingListView) {
	<section id="pending" class={ templ.KV("pending", len(v.Matches) > 0) } hx-swap-oob="true">
		@pendingItems(v)
	</section>
}

// pendingItems renders nothing at all when there is nothing waiting. A card
// saying "nothing to confirm" is a line to read past every single time, and
// the badge in the top bar already says so by being absent.
//
// The empty <section> stays in the document because the out-of-band swaps
// after a ruling need something to aim at.
templ pendingItems(v PendingListView) {
	if len(v.Matches) > 0 {
		<h2>Zu bestätigen</h2>
		<ul class="pending-list">
			for _, m := range v.Matches {
				@PendingItem(m)
			}
		</ul>
	}
}

// PendingItem is one entry, and the only place that decides which of the two
// states it is in. The actions swap this same element, so the list and the
// answer to an action cannot drift apart.
templ PendingItem(m PendingMatchView) {
	<li id={ "pending-" + m.ID } class={ templ.KV("disputed", m.Disputed) }>
		if m.Disputed {
			@correctionForm(m)
		} else {
			@reportedResult(m)
		}
	</li>
}

templ reportedResult(m PendingMatchView) {
	<div class="pending-match">
		<p>
			<strong>{ m.ReporterName }</strong> hat eingetragen:
			if m.Won {
				{ strconv.Itoa(m.OwnSets) }:{ strconv.Itoa(m.OpponentSets) } für dich
			} else {
				{ strconv.Itoa(m.OpponentSets) }:{ strconv.Itoa(m.OwnSets) } für { m.ReporterName }
			}
		</p>
		<p class="sets-line muted">
			for i, s := range m.Sets {
				if i > 0 {
					{ ", " }
				}
				{ strconv.Itoa(s.Own) }:{ strconv.Itoa(s.Opponent) }
			}
		</p>
		<div class="actions">
			<button
				hx-post={ "/matches/" + m.ID + "/confirm" }
				hx-target={ "#pending-" + m.ID }
				hx-swap="outerHTML"
			>
				Stimmt
			</button>
			<button
				class="secondary"
				hx-post={ "/matches/" + m.ID + "/dispute" }
				hx-target={ "#pending-" + m.ID }
				hx-swap="outerHTML"
			>
				Stimmt nicht
			</button>
		</div>
	</div>
}

// correctionForm is what a contested result offers instead of a dead end.
//
// Pre-filled with what was reported, from the reader's side, because a
// disputed result is usually nearly right — one set typed the wrong way
// round. Retyping all of it to fix one number is how a correction stops
// being worth the trouble.
//
// The prompt names neither side: who disputed is not recorded, and it does
// not matter. Either participant may put it right.
templ correctionForm(m PendingMatchView) {
	<div class="pending-match">
		<p>
			<strong>Strittig.</strong> Trag ein, wie es wirklich ausgegangen
			ist — { m.OpponentName } bestätigt es danach.
		</p>
		<form
			hx-post={ "/matches/" + m.ID + "/correct" }
			hx-target={ "#pending-" + m.ID }
			hx-swap="outerHTML"
		>
			@modeRow("fix-"+m.ID, m.BestOf, m.PointsToWin)
			@setRows("fix-"+m.ID, m.Inputs, m.BestOf, m.PointsToWin)
			<button type="submit">Korrigieren</button>
			if m.Error != "" {
				<p class="fail" role="alert">{ m.Error }</p>
			}
		</form>
	</div>
}

// Corrected replaces a list entry once the corrected result is on its way to
// the opponent.
templ Corrected(v CorrectedView) {
	<li id={ "pending-" + v.ID } class="settled">
		<p>
			Korrigiert auf
			{ strconv.Itoa(v.OwnSets) }:{ strconv.Itoa(v.OpponentSets) }
			gegen { v.OpponentName }.
		</p>
		<p class="muted">
			{ v.OpponentName } muss das jetzt bestätigen. Bis dahin zählt es
			nicht für die Wertung.
		</p>
	</li>
}

// Settled replaces a list entry once the result counts.
templ Settled(v SettledView) {
	<li id={ "pending-" + v.ID } class="settled">
		<p>
			Bestätigt:
			if v.Won {
				<strong>Gewonnen</strong>
			} else {
				<strong>Verloren</strong>
			}
			gegen { v.OpponentName } mit
			{ strconv.Itoa(v.OwnSets) }:{ strconv.Itoa(v.OpponentSets) } Sätzen.
		</p>
		<p>
			if v.Delta > 0 {
				<span class="gain">+{ strconv.Itoa(v.Delta) }</span>
			} else {
				<span class="loss">{ strconv.Itoa(v.Delta) }</span>
			}
			TTR, jetzt { strconv.Itoa(v.NewTTR) }.
		</p>
	</li>
}
