# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored: it holds
# the subscription and the secrets, and nothing else. Every other value is in
# schmetterpause.auto.tfvars.

subscription_id = "00000000-0000-0000-0000-000000000000"

# openssl rand -base64 32
# Generate once and keep it. A new key logs every player out.
session_key = ""

# Letters and digits, all three classes present:
#   openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | cut -c1-40
postgres_password = ""

# Optional. Left out, there is no kiosk.
#   openssl rand -hex 32
# kiosk_token = ""
